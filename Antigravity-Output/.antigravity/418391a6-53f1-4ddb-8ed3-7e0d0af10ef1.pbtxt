          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        <div className=\"bg-[#1A1A1A] text-white p-8 mb-8\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                          <h5 className=\"text-[10px] uppercase tracking-widest font-bold text-white/50 mb-6\">Key Results</h5>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
