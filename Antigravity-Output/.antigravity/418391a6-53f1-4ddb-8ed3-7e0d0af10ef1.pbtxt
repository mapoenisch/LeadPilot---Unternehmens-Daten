    instruction: "Update colors in FAQ.tsx"
    replacement_infos {
      original_chunk {
        target_content: "export function FAQ() {\n  const [openIndex, setOpenIndex] = useState<number | null>(0);\n\n  const toggleFAQ = (index: number) => {\n    setOpenIndex(openIndex === index ? null : index);\n  };\n\n  return (\n    <section className=\"py-32 bg-[#F9F8F6] border-b border-[#1A1A1A]/10\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-10\">\n        <div className=\"grid md:grid-cols-12 gap-16 items-start\">\n          <div className=\"md:col-span-5\">\n            <motion.div\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.8, ease: \"easeOut\" }}\n              className=\"sticky top-32\"\n            >\n              <h2 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-[#1A1A1A]/50\">FAQ</h2>\n              <h3 className=\"text-[40px] md:text-[60px] leading-[0.9] font-black uppercase tracking-tighter mb-8\">\n                H\303\244ufige<br /><span className=\"font-serif italic font-normal tracking-normal text-[#1A1A1A]/40\">Fragen.</span>\n              </h3>\n              <p className=\"text-sm leading-relaxed text-[#1A1A1A]/70 max-w-sm\">\n                Antworten auf die wichtigsten Fragen zur Einf\303\274hrung, Sicherheit und Nutzung von LeadPilot.\n              </p>\n            </motion.div>\n          </div>\n          \n          <div className=\"md:col-span-7\">\n            <div className=\"border-t border-[#1A1A1A]/10\">\n              {faqs.map((faq, index) => {\n                const isOpen = openIndex === index;\n                return (\n                  <motion.div \n                    key={index}\n                    initial={{ opacity: 0, y: 20 }}\n                    whileInView={{ opacity: 1, y: 0 }}\n                    viewport={{ once: true }}\n                    transition={{ duration: 0.5, delay: index * 0.1 }}\n                    className=\"border-b border-[#1A1A1A]/10\"\n                  >\n                    <button\n                      onClick={() => toggleFAQ(index)}\n                      className=\"w-full flex justify-between items-center py-8 text-left group\"\n                    >\n                      <span className=\"font-serif italic text-xl md:text-2xl text-[#1A1A1A] group-hover:text-[#1A1A1A]/60 transition-colors pr-8\">\n                        {faq.question}\n                      </span>\n                      <span className=\"shrink-0 flex items-center justify-center w-10 h-10 rounded-full border border-[#1A1A1A]/20 group-hover:bg-[#1A1A1A] group-hover:text-white transition-colors text-[#1A1A1A]\">\n                        {isOpen ? <Minus className=\"w-4 h-4\" /> : <Plus className=\"w-4 h-4\" />}\n                      </span>\n                    </button>\n                    <AnimatePresence>\n                      {isOpen && (\n                        <motion.div\n                          initial={{ height: 0, opacity: 0 }}\n                          animate={{ height: \"auto\", opacity: 1 }}\n                          exit={{ height: 0, opacity: 0 }}\n                          transition={{ duration: 0.3, ease: \"easeInOut\" }}\n                          className=\"overflow-hidden\"\n                        >\n                          <p className=\"pb-8 text-sm leading-relaxed text-[#1A1A1A]/70 max-w-2xl\">\n                            {faq.answer}\n                          </p>\n                        </motion.div>\n                      )}\n                    </AnimatePresence>\n                  </motion.div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}"
        replacement_content: "export function FAQ() {\n  const [openIndex, setOpenIndex] = useState<number | null>(0);\n\n  const toggleFAQ = (index: number) => {\n    setOpenIndex(openIndex === index ? null : index);\n  };\n\n  return (\n    <section className=\"py-32 bg-[#F9F8F6] border-b border-[#1A1A1A]/10\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-10\">\n        <div className=\"grid md:grid-cols-12 gap-16 items-start\">\n          <div className=\"md:col-span-5\">\n            <motion.div\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.8, ease: \"easeOut\" }}\n              className=\"sticky top-32\"\n            >\n              <h2 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-[#E56014]\">FAQ</h2>\n              <h3 className=\"text-[40px] md:text-[60px] leading-[0.9] font-black uppercase tracking-tighter mb-8\">\n                H\303\244ufige<br /><span className=\"font-serif italic font-normal tracking-normal text-[#23BAA4]\">Fragen.</span>\n              </h3>\n              <p className=\"text-sm leading-relaxed text-[#1A1A1A]/70 max-w-sm\">\n                Antworten auf die wichtigsten Fragen zur Einf\303\274hrung, Sicherheit und Nutzung von LeadPilot.\n              </p>\n            </motion.div>\n          </div>\n          \n          <div className=\"md:col-span-7\">\n            <div className=\"border-t border-[#1A1A1A]/10\">\n              {faqs.map((faq, index) => {\n                const isOpen = openIndex === index;\n                return (\n                  <motion.div \n                    key={index}\n                    initial={{ opacity: 0, y: 20 }}\n                    whileInView={{ opacity: 1, y: 0 }}\n                    viewport={{ once: true }}\n                    transition={{ duration: 0.5, delay: index * 0.1 }}\n                    className=\"border-b border-[#1A1A1A]/10\"\n                  >\n                    <button\n                      onClick={() => toggleFAQ(index)}\n                      className=\"w-full flex justify-between items-center py-8 text-left group\"\n                    >\n                      <span className=\"font-serif italic text-xl md:text-2xl text-[#1A1A1A] group-hover:text-[#E56014] transition-colors pr-8\">\n                        {faq.question}\n                      </span>\n                      <span className={`shrink-0 flex items-center justify-center w-10 h-10 rounded-full border border-[#1A1A1A]/20 transition-colors ${isOpen ? \'bg-[#E56014] text-white border-[#E56014]\' : \'group-hover:bg-[#E56014] group-hover:text-white group-hover:border-[#E56014] text-[#1A1A1A]\'}`}>\n                        {isOpen ? <Minus className=\"w-4 h-4\" /> : <Plus className=\"w-4 h-4\" />}\n                      </span>\n                    </button>\n                    <AnimatePresence>\n                      {isOpen && (\n                        <motion.div\n                          initial={{ height: 0, opacity: 0 }}\n                          animate={{ height: \"auto\", opacity: 1 }}\n                          exit={{ height: 0, opacity: 0 }}\n                          transition={{ duration: 0.3, ease: \"easeInOut\" }}\n                          className=\"overflow-hidden\"\n                        >\n                          <p className=\"pb-8 text-sm leading-relaxed text-[#1A1A1A]/70 max-w-2xl\">\n                            {faq.answer}\n                          </p>\n                        </motion.div>\n                      )}\n                    </AnimatePresence>\n                  </motion.div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}"
      }
      num_matches: 1
    }
  }
}
