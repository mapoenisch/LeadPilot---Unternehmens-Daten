    instruction: "Apply editorial style to Footer"
    replacement_infos {
      original_chunk {
        target_content: "    <footer className=\"bg-slate-900 text-slate-300 py-12 border-t border-slate-800\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 border-b border-slate-800 pb-8\">\n          <div className=\"md:col-span-1\">\n            <div className=\"flex items-center gap-2 mb-4\">\n              <div className=\"bg-teal-600 p-1.5 rounded-lg\">\n                <Rocket className=\"h-5 w-5 text-white\" />\n              </div>\n              <span className=\"text-xl font-bold text-white tracking-tight\">Lead<span className=\"text-teal-500\">Pilot</span></span>\n            </div>\n            <p className=\"text-sm text-slate-400 mb-4\">\n              Das KI-gest\303\274tzte Sales-CRM, das daf\303\274r sorgt, dass kein Lead im B2B-Mittelstand mehr vergessen wird.\n            </p>\n          </div>\n          \n          <div>\n            <h4 className=\"text-white font-semibold mb-4\">Produkt</h4>\n            <ul className=\"space-y-2 text-sm\">\n              <li><a href=\"#funktionen\" className=\"hover:text-teal-400 transition-colors\">Funktionen</a></li>\n              <li><a href=\"#preise\" className=\"hover:text-teal-400 transition-colors\">Preise</a></li>\n              <li><a href=\"#\" className=\"hover:text-teal-400 transition-colors\">Integrationen</a></li>\n              <li><a href=\"#\" className=\"hover:text-teal-400 transition-colors\">Updates</a></li>\n            </ul>\n          </div>\n          \n          <div>\n            <h4 className=\"text-white font-semibold mb-4\">Ressourcen</h4>\n            <ul className=\"space-y-2 text-sm\">\n              <li><a href=\"#\" className=\"hover:text-teal-400 transition-colors\">Blog</a></li>\n              <li><a href=\"#\" className=\"hover:text-teal-400 transition-colors\">Webinare</a></li>\n              <li><a href=\"#\" className=\"hover:text-teal-400 transition-colors\">Hilfe-Center</a></li>\n              <li><a href=\"#\" className=\"hover:text-teal-400 transition-colors\">Kunden-Cases</a></li>\n            </ul>\n          </div>\n          \n          <div>\n            <h4 className=\"text-white font-semibold mb-4\">Rechtliches</h4>\n            <ul className=\"space-y-2 text-sm\">\n              <li><a href=\"#\" className=\"hover:text-teal-400 transition-colors\">Impressum</a></li>\n              <li><a href=\"#\" className=\"hover:text-teal-400 transition-colors\">Datenschutz</a></li>\n              <li><a href=\"#\" className=\"hover:text-teal-400 transition-colors\">AGB</a></li>\n              <li className=\"flex items-center gap-2 mt-4 text-teal-400\">\n                <span className=\"w-2 h-2 rounded-full bg-teal-500\"></span>\n                DSGVO-konform\n              </li>\n            </ul>\n          </div>\n        </div>\n        \n        <div className=\"flex flex-col md:flex-row justify-between items-center text-sm text-slate-500\">\n          <p>&copy; {new Date().getFullYear()} LeadPilot GmbH. Alle Rechte vorbehalten.</p>\n          <div className=\"flex gap-4 mt-4 md:mt-0\">\n            <a href=\"#\" className=\"hover:text-white transition-colors\">LinkedIn</a>\n            <a href=\"#\" className=\"hover:text-white transition-colors\">Twitter</a>\n          </div>\n        </div>\n      </div>\n    </footer>"
        replacement_content: "    <footer className=\"bg-[#F9F8F6] text-[#1A1A1A] border-t border-[#1A1A1A]/10\">\n      <div className=\"grid md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-[#1A1A1A]/10\">\n        <div className=\"p-10 flex flex-col justify-between min-h-[300px]\">\n          <div>\n            <span className=\"text-2xl font-black tracking-tighter uppercase italic block mb-6\">LeadPilot.</span>\n            <p className=\"text-sm leading-relaxed text-[#1A1A1A]/60\">\n              Das KI-gest\303\274tzte Sales-CRM, das daf\303\274r sorgt, dass kein Lead im B2B-Mittelstand mehr vergessen wird.\n            </p>\n          </div>\n          <div className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/40 mt-12\">\n            \302\251 {new Date().getFullYear()} LeadPilot\n          </div>\n        </div>\n        \n        <div className=\"p-10 flex flex-col\">\n          <h4 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-[#1A1A1A]/50\">Produkt</h4>\n          <ul className=\"space-y-4\">\n            <li><a href=\"#funktionen\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Funktionen</a></li>\n            <li><a href=\"#preise\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Preise</a></li>\n            <li><a href=\"#\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Integrationen</a></li>\n            <li><a href=\"#\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Updates</a></li>\n          </ul>\n        </div>\n        \n        <div className=\"p-10 flex flex-col\">\n          <h4 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-[#1A1A1A]/50\">Ressourcen</h4>\n          <ul className=\"space-y-4\">\n            <li><a href=\"#\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Blog</a></li>\n            <li><a href=\"#\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Webinare</a></li>\n            <li><a href=\"#\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Hilfe-Center</a></li>\n            <li><a href=\"#\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Kunden-Cases</a></li>\n          </ul>\n        </div>\n        \n        <div className=\"p-10 flex flex-col justify-between min-h-[300px]\">\n          <div>\n            <h4 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-[#1A1A1A]/50\">Rechtliches</h4>\n            <ul className=\"space-y-4\">\n              <li><a href=\"#\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Impressum</a></li>\n              <li><a href=\"#\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">Datenschutz</a></li>\n              <li><a href=\"#\" className=\"text-xs uppercase tracking-widest font-bold hover:text-[#1A1A1A]/60 transition-colors\">AGB</a></li>\n            </ul>\n          </div>\n          <div className=\"mt-12 flex gap-4\">\n            <a href=\"#\" className=\"text-[10px] uppercase tracking-widest font-bold border-b border-[#1A1A1A] pb-1 hover:text-[#1A1A1A]/60 transition-colors\">LinkedIn</a>\n            <a href=\"#\" className=\"text-[10px] uppercase tracking-widest font-bold border-b border-[#1A1A1A] pb-1 hover:text-[#1A1A1A]/60 transition-colors\">Twitter</a>\n          </div>\n        </div>\n      </div>\n    </footer>"
