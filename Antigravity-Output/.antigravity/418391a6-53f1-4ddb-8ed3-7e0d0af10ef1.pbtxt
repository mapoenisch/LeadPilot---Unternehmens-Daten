    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useState, useMemo } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport {\n  BarChart,\n  Bar,\n  XAxis,\n  YAxis,\n  CartesianGrid,\n  Tooltip,\n  ResponsiveContainer,\n  AreaChart,\n  Area,\n  Line,\n  ComposedChart,\n  Cell,\n  PieChart,\n  Pie\n} from \'recharts\';\nimport {\n  TrendingUp,\n  Activity,\n  Sliders,\n  DollarSign,\n  Users,\n  Target,\n  ArrowUpRight,\n  Sparkles,\n  Layers,\n  Calendar,\n  CheckCircle2,\n  RefreshCw,\n  Zap,\n  Info\n} from \'lucide-react\';\n\ninterface StageData {\n  id: string;\n  stage: string;\n  shortName: string;\n  leads: number;\n  value: number;\n  conversionRate: number;\n  avgDays: number;\n  color: string;\n  dropOffRate: number;\n  topChannels: { channel: string; share: string }[];\n}\n\nconst basePipelineStages: StageData[] = [\n  {\n    id: \'inbound\',\n    stage: \'1. Inbound Leads\',\n    shortName: \'Inbound\',\n    leads: 1240,\n    value: 1860000,\n    conversionRate: 100,\n    avgDays: 1.2,\n    color: \'#23BAA4\',\n    dropOffRate: 24,\n    topChannels: [\n      { channel: \'Web-Formular\', share: \'45%\' },\n      { channel: \'LinkedIn Kampagnen\', share: \'35%\' },\n      { channel: \'Empfehlungen\', share: \'20%\' }\n    ]\n  },\n  {\n    id: \'contacted\',\n    stage: \'2. Qualifiziert & Erstkontakt\',\n    shortName: \'Erstkontakt\',\n    leads: 942,\n    value: 1554000,\n    conversionRate: 76.0,\n    avgDays: 2.8,\n    color: \'#34D399\',\n    dropOffRate: 28,\n    topChannels: [\n      { channel: \'Automatischer Speed-Call\', share: \'62%\' },\n      { channel: \'E-Mail Sequenz\', share: \'38%\' }\n    ]\n  },\n  {\n    id: \'demo\',\n    stage: \'3. Produkt-Demo & Pitch\',\n    shortName: \'Demo\',\n    leads: 678,\n    value: 1288000,\n    conversionRate: 72.0,\n    avgDays: 5.4,\n    color: \'#FBBF24\',\n    dropOffRate: 22,\n    topChannels: [\n      { channel: \'Live-Demo (Zoom/Teams)\', share: \'85%\' },\n      { channel: \'Vor-Ort Termin\', share: \'15%\' }\n    ]\n  },\n  {\n    id: \'proposal\',\n    stage: \'4. Angebot & Verhandlung\',\n    shortName: \'Angebot\',\n    leads: 528,\n    value: 1056000,\n    conversionRate: 77.9,\n    avgDays: 7.1,\n    color: \'#FB923C\',\n    dropOffRate: 18,\n    topChannels: [\n      { channel: \'Standard SaaS Lizenz\', share: \'60%\' },\n      { channel: \'Enterprise Custom\', share: \'40%\' }\n    ]\n  },\n  {\n    id: \'won\',\n    stage: \'5. Abschluss (Closed Won)\',\n    shortName: \'Abschluss\',\n    leads: 412,\n    value: 824000,\n    conversionRate: 78.0,\n    avgDays: 14.5,\n    color: \'#E56014\',\n    dropOffRate: 0,\n    topChannels: [\n      { channel: \'Jahresvertrag (Voraus)\', share: \'70%\' },\n      { channel: \'Monatsabrechnung\', share: \'30%\' }\n    ]\n  }\n];\n\nconst baseMonthlyProjection = [\n  { month: \'Jan\', actual: 48000, projected: 48000, target: 45000, optimistic: 51000, baseline: 46000 },\n  { month: \'Feb\', actual: 54000, projected: 54000, target: 50000, optimistic: 58000, baseline: 52000 },\n  { month: \'M\303\244r\', actual: 63000, projected: 63000, target: 56000, optimistic: 67000, baseline: 60000 },\n  { month: \'Apr\', actual: 72000, projected: 72000, target: 62000, optimistic: 76000, baseline: 68000 },\n  { month: \'Mai\', actual: 85000, projected: 85000, target: 70000, optimistic: 89000, baseline: 80000 },\n  { month: \'Jun\', actual: 98000, projected: 98000, target: 78000, optimistic: 104000, baseline: 92000 },\n  { month: \'Jul\', actual: null, projected: 112000, target: 86000, optimistic: 122000, baseline: 104000 },\n  { month: \'Aug\', actual: null, projected: 128000, target: 95000, optimistic: 141000, baseline: 118000 },\n  { month: \'Sep\', actual: null, projected: 146000, target: 105000, optimistic: 164000, baseline: 132000 },\n  { month: \'Okt\', actual: null, projected: 168000, target: 116000, optimistic: 191000, baseline: 150000 },\n  { month: \'Nov\', actual: null, projected: 192000, target: 128000, optimistic: 220000, baseline: 170000 },\n  { month: \'Dez\', actual: null, projected: 224000, target: 140000, optimistic: 258000, baseline: 195000 }\n];\n\nconst sampleDeals = [\n  { id: \'D-801\', company: \'Maschinenbau Weber GmbH\', value: \'\342\202\25442.000\', stage: \'Angebot & Verhandlung\', prob: \'85%\', rep: \'Sarah M.\', nextAction: \'Vertragspr\303\274fung via DocuSign\', status: \'hot\' },\n  { id: \'D-802\', company: \'LogiFlow Solutions AG\', value: \'\342\202\25428.500\', stage: \'Produkt-Demo\', prob: \'60%\', rep: \'Julian K.\', nextAction: \'Technisches Deep-Dive Follow-up\', status: \'warm\' },\n  { id: \'D-803\', company: \'Klausen Precision Parts\', value: \'\342\202\25464.000\', stage: \'Erstkontakt qualifiziert\', prob: \'45%\', rep: \'Elena B.\', nextAction: \'Entscheider-Call Terminierung\', status: \'active\' },\n  { id: \'D-804\', company: \'Bavaria SolarTech KG\', value: \'\342\202\25419.200\', stage: \'Abschlussphase\', prob: \'95%\', rep: \'Sarah M.\', nextAction: \'Onboarding Termin best\303\244tigen\', status: \'closing\' }\n];\n\nexport function CRMDashboard() {\n  const [activeTab, setActiveTab] = useState<\'funnel\' | \'forecast\' | \'deals\'>(\'funnel\');\n  const [timeRange, setTimeRange] = useState<\'30d\' | \'90d\' | \'12m\'>(\'90d\');\n  const [selectedStage, setSelectedStage] = useState<StageData>(basePipelineStages[0]);\n  \n  // Interactive Simulation Controls for Revenue Projection\n  const [leadBoost, setLeadBoost] = useState<number>(15); // +15% leads\n  const [convBoost, setConvBoost] = useState<number>(20); // +20% conversion\n  const [dealSizeBoost, setDealSizeBoost] = useState<number>(10); // +10% deal size\n  const [isSimulating, setIsSimulating] = useState<boolean>(true);\n\n  // Filter multiplier based on time range\n  const timeMultiplier = useMemo(() => {\n    switch (timeRange) {\n      case \'30d\': return 0.38;\n      case \'90d\': return 1.0;\n      case \'12m\': return 3.6;\n    }\n  }, [timeRange]);\n\n  // Scaled pipeline stages\n  const calculatedStages = useMemo(() => {\n    const boostFactor = isSimulating ? 1 + (leadBoost / 100) : 1;\n    const convFactor = isSimulating ? 1 + (convBoost / 100) : 1;\n    const dealFactor = isSimulating ? 1 + (dealSizeBoost / 100) : 1;\n\n    return basePipelineStages.map((stage, idx) => {\n      const baseLeads = Math.round(stage.leads * timeMultiplier * boostFactor);\n      // compound conversion gains downstream\n      const stageConv = Math.min(96, Math.round(stage.conversionRate * (idx > 0 ? convFactor : 1) * 10) / 10);\n      const stageValue = Math.round(stage.value * timeMultiplier * boostFactor * dealFactor);\n      return {\n        ...stage,\n        leads: baseLeads,\n        value: stageValue,\n        conversionRate: stageConv\n      };\n    });\n  }, [timeMultiplier, isSimulating, leadBoost, convBoost, dealSizeBoost]);\n\n  // Dynamic Revenue Projections\n  const dynamicProjections = useMemo(() => {\n    const boost = isSimulating ? (1 + (leadBoost * 0.007) + (convBoost * 0.012) + (dealSizeBoost * 0.008)) : 1;\n    return baseMonthlyProjection.map((item) => {\n      const projected = Math.round(item.projected * boost);\n      const optimistic = Math.round(item.optimistic * boost * 1.08);\n      const baseline = Math.round(item.baseline * (boost * 0.92));\n      return {\n        ...item,\n        projected,\n        optimistic,\n        baseline\n      };\n    });\n  }, [isSimulating, leadBoost, convBoost, dealSizeBoost]);\n\n  // Overall overall cumulative win rate\n  const totalInbound = calculatedStages[0].leads;\n  const totalWon = calculatedStages[calculatedStages.length - 1].leads;\n  const cumulativeWinRate = totalInbound > 0 ? ((totalWon / totalInbound) * 100).toFixed(1) : \'0.0\';\n  const totalPipelineValue = calculatedStages.reduce((acc, curr) => acc + curr.value, 0);\n  const totalProjectedARR = useMemo(() => {\n    const lastSixMonths = dynamicProjections.slice(6);\n    const avgMonthly = lastSixMonths.reduce((a, b) => a + b.projected, 0) / 6;\n    return avgMonthly * 12;\n  }, [dynamicProjections]);\n\n  return (\n    <section id=\"dashboard\" className=\"py-24 bg-white border-b border-[#1A1A1A]/10 relative overflow-hidden\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-10\">\n        {/* Section Header */}\n        <div className=\"flex flex-col lg:flex-row justify-between items-start lg:items-end mb-12 gap-8 border-b border-[#1A1A1A]/10 pb-10\">\n          <div className=\"max-w-2xl\">\n            <div className=\"flex items-center gap-3 mb-6\">\n              <span className=\"inline-flex items-center gap-1.5 px-3 py-1 bg-[#E56014]/10 text-[#E56014] text-[10px] uppercase font-bold tracking-widest rounded-full\">\n                <span className=\"w-2 h-2 rounded-full bg-[#E56014] animate-pulse\"></span>\n                Echtzeit CRM Dashboard\n              </span>\n              <span className=\"text-[10px] uppercase tracking-widest text-[#1A1A1A]/40 font-bold\">\n                Live Analytics & Forecasting\n              </span>\n            </div>\n            <h2 className=\"text-[36px] sm:text-[48px] md:text-[56px] leading-[0.95] font-black uppercase tracking-tighter\">\n              Pipeline Conversion &<br />\n              <span className=\"font-serif italic font-normal text-[#23BAA4]\">Umsatz-Prognosen.</span>\n            </h2>\n          </div>\n\n          {/* Time & View Switcher */}\n          <div className=\"flex flex-wrap items-center gap-4\">\n            {/* Time interval filter */}\n            <div className=\"flex items-center bg-[#F9F8F6] border border-[#1A1A1A]/10 p-1\">\n              <button\n                id=\"btn-range-30d\"\n                onClick={() => setTimeRange(\'30d\')}\n                className={`px-4 py-2 text-xs uppercase tracking-widest font-bold transition-all ${\n                  timeRange === \'30d\' ? \'bg-[#1A1A1A] text-white shadow-sm\' : \'text-[#1A1A1A]/60 hover:text-[#1A1A1A]\'\n                }`}\n              >\n                30 Tage\n              </button>\n              <button\n                id=\"btn-range-90d\"\n                onClick={() => setTimeRange(\'90d\')}\n                className={`px-4 py-2 text-xs uppercase tracking-widest font-bold transition-all ${\n                  timeRange === \'90d\' ? \'bg-[#1A1A1A] text-white shadow-sm\' : \'text-[#1A1A1A]/60 hover:text-[#1A1A1A]\'\n                }`}\n              >\n                Quartal (Q3)\n              </button>\n              <button\n                id=\"btn-range-12m\"\n                onClick={() => setTimeRange(\'12m\')}\n                className={`px-4 py-2 text-xs uppercase tracking-widest font-bold transition-all ${\n                  timeRange === \'12m\' ? \'bg-[#1A1A1A] text-white shadow-sm\' : \'text-[#1A1A1A]/60 hover:text-[#1A1A1A]\'\n                }`}\n              >\n                12 Monate\n              </button>\n            </div>\n\n            {/* View Switcher Tabs */}\n            <div className=\"flex items-center bg-[#F9F8F6] border border-[#1A1A1A]/10 p-1\">\n              <button\n                id=\"btn-tab-funnel\"\n                onClick={() => setActiveTab(\'funnel\')}\n                className={`flex items-center gap-2 px-4 py-2 text-xs uppercase tracking-widest font-bold transition-all ${\n                  activeTab === \'funnel\' ? \'bg-[#E56014] text-white shadow-sm\' : \'text-[#1A1A1A]/60 hover:text-[#1A1A1A]\'\n                }`}\n              >\n                <Layers className=\"w-3.5 h-3.5\" />\n                Pipeline Funnel\n              </button>\n              <button\n                id=\"btn-tab-forecast\"\n                onClick={() => setActiveTab(\'forecast\')}\n                className={`flex items-center gap-2 px-4 py-2 text-xs uppercase tracking-widest font-bold transition-all ${\n                  activeTab === \'forecast\' ? \'bg-[#E56014] text-white shadow-sm\' : \'text-[#1A1A1A]/60 hover:text-[#1A1A1A]\'\n                }`}\n              >\n                <TrendingUp className=\"w-3.5 h-3.5\" />\n                Revenue Forecast\n              </button>\n              <button\n                id=\"btn-tab-deals\"\n                onClick={() => setActiveTab(\'deals\')}\n                className={`flex items-center gap-2 px-4 py-2 text-xs uppercase tracking-widest font-bold transition-all ${\n                  activeTab === \'deals\' ? \'bg-[#E56014] text-white shadow-sm\' : \'text-[#1A1A1A]/60 hover:text-[#1A1A1A]\'\n                }`}\n              >\n                <Activity className=\"w-3.5 h-3.5\" />\n                Live Deals\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Top Highlight KPI Bar */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-10\">\n          <div className=\"p-6 bg-[#F9F8F6] border border-[#1A1A1A]/10 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-[#1A1A1A]/50 mb-4\">\n              <span className=\"text-[10px] uppercase font-bold tracking-widest\">End-to-End Win Rate</span>\n              <Target className=\"w-4 h-4 text-[#23BAA4]\" />\n            </div>\n            <div>\n              <div className=\"text-3xl sm:text-4xl font-black tracking-tight text-[#1A1A1A] flex items-baseline gap-2\">\n                {cumulativeWinRate}%\n                <span className=\"text-xs font-bold text-[#23BAA4] flex items-center\">\n                  <ArrowUpRight className=\"w-3.5 h-3.5\" /> +14.2%\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#1A1A1A]/60 mt-1\">Branchenschnitt liegt bei nur 18%</p>\n            </div>\n          </div>\n\n          <div className=\"p-6 bg-[#F9F8F6] border border-[#1A1A1A]/10 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-[#1A1A1A]/50 mb-4\">\n              <span className=\"text-[10px] uppercase font-bold tracking-widest\">Aktive Pipeline</span>\n              <DollarSign className=\"w-4 h-4 text-[#E56014]\" />\n            </div>\n            <div>\n              <div className=\"text-3xl sm:text-4xl font-black tracking-tight text-[#1A1A1A] flex items-baseline gap-2\">\n                \342\202\254{(totalPipelineValue / 1000).toLocaleString(\'de-DE\', { maximumFractionDigits: 0 })}k\n                <span className=\"text-xs font-bold text-[#23BAA4] flex items-center\">\n                  <ArrowUpRight className=\"w-3.5 h-3.5\" /> +28%\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#1A1A1A]/60 mt-1\">Gewichteter Pipeline-Gesamtwert</p>\n            </div>\n          </div>\n\n          <div className=\"p-6 bg-[#F9F8F6] border border-[#1A1A1A]/10 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-[#1A1A1A]/50 mb-4\">\n              <span className=\"text-[10px] uppercase font-bold tracking-widest\">Prognostizierter ARR</span>\n              <TrendingUp className=\"w-4 h-4 text-[#23BAA4]\" />\n            </div>\n            <div>\n              <div className=\"text-3xl sm:text-4xl font-black tracking-tight text-[#1A1A1A] flex items-baseline gap-2\">\n                \342\202\254{(totalProjectedARR / 1000000).toFixed(2)}M\n                <span className=\"text-xs font-bold text-[#E56014] flex items-center\">\n                  On-Track\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#1A1A1A]/60 mt-1\">Jahres-Umsatzlaufzeit (Run-Rate)</p>\n            </div>\n          </div>\n\n          <div className=\"p-6 bg-[#F9F8F6] border border-[#1A1A1A]/10 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-[#1A1A1A]/50 mb-4\">\n              <span className=\"text-[10px] uppercase font-bold tracking-widest\">Vertriebs-Geschwindigkeit</span>\n              <Zap className=\"w-4 h-4 text-[#E56014]\" />\n            </div>\n            <div>\n              <div className=\"text-3xl sm:text-4xl font-black tracking-tight text-[#1A1A1A] flex items-baseline gap-2\">\n                14.5 T.\n                <span className=\"text-xs font-bold text-[#23BAA4] flex items-center\">\n                  -42% Zeit\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#1A1A1A]/60 mt-1\">Lead bis Abschluss (Vorher: 25 Tage)</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Dynamic View Tab 1: Pipeline Funnel Breakdown */}\n        {activeTab === \'funnel\' && (\n          <motion.div\n            key=\"tab-funnel\"\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.4 }}\n            className=\"grid lg:grid-cols-12 gap-8\"\n          >\n            {/* Funnel Bar Chart */}\n            <div className=\"lg:col-span-8 bg-white border border-[#1A1A1A]/10 p-6 sm:p-8\">\n              <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n                <div>\n                  <h3 className=\"text-xl font-bold tracking-tight text-[#1A1A1A]\">\n                    Stufen-Conversion & Lead-Volumen\n                  </h3>\n                  <p className=\"text-xs text-[#1A1A1A]/60 mt-1\">\n                    Klicken Sie auf eine Phase, um tiefe Detailanalysen und Abwanderungsquoten einzusehen.\n                  </p>\n                </div>\n                <div className=\"text-[11px] font-bold text-[#23BAA4] bg-[#23BAA4]/10 px-3 py-1.5 rounded-full flex items-center gap-1.5\">\n                  <CheckCircle2 className=\"w-3.5 h-3.5\" /> Automatische Lead-\303\234bergabe aktiv\n                </div>\n              </div>\n\n              {/* Recharts Funnel Representation */}\n              <div className=\"h-80 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <BarChart\n                    data={calculatedStages}\n                    margin={{ top: 20, right: 20, left: -10, bottom: 20 }}\n                    onClick={(data) => {\n                      if (data && data.activePayload && data.activePayload.length) {\n                        setSelectedStage(data.activePayload[0].payload);\n                      }\n                    }}\n                  >\n                    <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#1A1A1A\" strokeOpacity={0.08} />\n                    <XAxis\n                      dataKey=\"shortName\"\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 12, fontWeight: 600 }}\n                      dy={10}\n                    />\n                    <YAxis\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 11, opacity: 0.6 }}\n                      tickFormatter={(val) => `${val}`}\n                    />\n                    <Tooltip\n                      cursor={{ fill: \'#1A1A1A\', opacity: 0.04 }}\n                      content={({ active, payload }) => {\n                        if (active && payload && payload.length) {\n                          const item = payload[0].payload as StageData;\n                          return (\n                            <div className=\"bg-[#1A1A1A] text-white p-4 text-xs shadow-2xl border border-white/10\">\n                              <p className=\"font-bold text-[#23BAA4] uppercase tracking-wider mb-1\">{item.stage}</p>\n                              <div className=\"space-y-1\">\n                                <p><span className=\"text-white/60\">Anzahl Leads:</span> <strong className=\"text-white\">{item.leads.toLocaleString()}</strong></p>\n                                <p><span className=\"text-white/60\">Stufen-Conversion:</span> <strong className=\"text-[#E56014]\">{item.conversionRate}%</strong></p>\n                                <p><span className=\"text-white/60\">Pipeline-Volumen:</span> <strong className=\"text-white\">\342\202\254{(item.value).toLocaleString()}</strong></p>\n                                <p><span className=\"text-white/60\">Durchschnittliche Verweildauer:</span> <strong className=\"text-white\">{item.avgDays} Tage</strong></p>\n                              </div>\n                            </div>\n                          );\n                        }\n                        return null;\n                      }}\n                    />\n                    <Bar dataKey=\"leads\" radius={[4, 4, 0, 0]} cursor=\"pointer\">\n                      {calculatedStages.map((entry, index) => (\n                        <Cell\n                          key={`cell-${index}`}\n                          fill={selectedStage.id === entry.id ? \'#E56014\' : entry.color}\n                          opacity={selectedStage.id === entry.id ? 1 : 0.85}\n                        />\n                      ))}\n                    </Bar>\n                  </BarChart>\n                </ResponsiveContainer>\n              </div>\n\n              {/* Step Transition Pills */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-2 mt-6 pt-6 border-t border-[#1A1A1A]/10\">\n                {calculatedStages.map((stg) => (\n                  <button\n                    key={stg.id}\n                    onClick={() => setSelectedStage(stg)}\n                    className={`p-3 text-left border transition-all ${\n                      selectedStage.id === stg.id\n                        ? \'border-[#E56014] bg-[#E56014]/5 shadow-sm\'\n                        : \'border-[#1A1A1A]/10 bg-[#F9F8F6] hover:border-[#1A1A1A]/30\'\n                    }`}\n                  >\n                    <div className=\"text-[10px] uppercase font-bold text-[#1A1A1A]/60 tracking-wider truncate\">\n                      {stg.shortName}\n                    </div>\n                    <div className=\"text-lg font-black text-[#1A1A1A] mt-0.5\">\n                      {stg.leads} <span className=\"text-[11px] font-normal text-[#1A1A1A]/50\">Leads</span>\n                    </div>\n                    <div className=\"text-[10px] font-bold text-[#23BAA4] mt-1 flex items-center justify-between\">\n                      <span>Conv: {stg.conversionRate}%</span>\n                    </div>\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Stage Inspector Sidebar */}\n            <div className=\"lg:col-span-4 flex flex-col gap-6\">\n              <div className=\"bg-[#1A1A1A] text-white p-6 sm:p-8 flex flex-col justify-between flex-1\">\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <span className=\"text-[10px] uppercase tracking-[0.3em] font-bold text-[#23BAA4]\">\n                      Phasen-Inspektor\n                    </span>\n                    <span className=\"text-[11px] px-2.5 py-0.5 rounded-full bg-white/10 font-mono text-white/80\">\n                      {selectedStage.shortName}\n                    </span>\n                  </div>\n                  <h4 className=\"text-2xl font-serif italic text-white mb-2\">\n                    {selectedStage.stage}\n                  </h4>\n                  <p className=\"text-xs text-white/70 leading-relaxed mb-6\">\n                    In dieser Phase sorgt LeadPilot f\303\274r automatisierte Erinnerungen und sofortiges Wiedervorlegen, sobald ein Interessent inaktiv wird.\n                  </p>\n\n                  <div className=\"space-y-4 border-t border-white/10 pt-6\">\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Aktive Interessenten:</span>\n                      <strong className=\"text-white font-mono text-sm\">{selectedStage.leads} Leads</strong>\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Gesamtwert in Phase:</span>\n                      <strong className=\"text-[#E56014] font-mono text-sm\">\342\202\254{selectedStage.value.toLocaleString()}</strong>\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Durchschnittliche Verweildauer:</span>\n                      <strong className=\"text-white font-mono text-sm\">{selectedStage.avgDays} Tage</strong>\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Gefahr von Lead-Dropoff:</span>\n                      <strong className=\"text-emerald-400 font-mono text-sm\">Minimal ({selectedStage.dropOffRate}% durch Auto-Follow-Up)</strong>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"mt-8 pt-6 border-t border-white/10\">\n                  <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/50 mb-3\">\n                    Haupteingangsquellen f\303\274r diese Stufe\n                  </div>\n                  <div className=\"space-y-2\">\n                    {selectedStage.topChannels.map((chn, i) => (\n                      <div key={i} className=\"flex justify-between text-xs items-center bg-white/5 p-2 rounded\">\n                        <span className=\"text-white/80\">{chn.channel}</span>\n                        <span className=\"font-bold text-[#23BAA4]\">{chn.share}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </motion.div>\n        )}\n\n        {/* Dynamic View Tab 2: Monthly Revenue Projections with Interactive Scenario Simulator */}\n        {activeTab === \'forecast\' && (\n          <motion.div\n            key=\"tab-forecast\"\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.4 }}\n            className=\"grid lg:grid-cols-12 gap-8\"\n          >\n            {/* Forecast Chart */}\n            <div className=\"lg:col-span-8 bg-white border border-[#1A1A1A]/10 p-6 sm:p-8\">\n              <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n                <div>\n                  <h3 className=\"text-xl font-bold tracking-tight text-[#1A1A1A]\">\n                    Monatliche Umsatzprognose & ARR Trajektorie\n                  </h3>\n                  <p className=\"text-xs text-[#1A1A1A]/60 mt-1\">\n                    Vergleich zwischen realisiertem Ist-Umsatz, Modellprognose und Zielen (MRR in \342\202\254).\n                  </p>\n                </div>\n                <div className=\"flex items-center gap-4 text-xs font-bold\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-3 h-3 bg-[#1A1A1A]\"></span> Ist-Umsatz\n                  </div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-3 h-3 bg-[#E56014]\"></span> Prognose\n                  </div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-3 h-3 bg-[#23BAA4]\"></span> Optimistisch\n                  </div>\n                </div>\n              </div>\n\n              {/* Recharts Composed Area & Line Chart */}\n              <div className=\"h-80 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <ComposedChart\n                    data={dynamicProjections}\n                    margin={{ top: 20, right: 20, left: 10, bottom: 20 }}\n                  >\n                    <defs>\n                      <linearGradient id=\"colorProjected\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                        <stop offset=\"5%\" stopColor=\"#E56014\" stopOpacity={0.3} />\n                        <stop offset=\"95%\" stopColor=\"#E56014\" stopOpacity={0.0} />\n                      </linearGradient>\n                      <linearGradient id=\"colorOptimistic\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                        <stop offset=\"5%\" stopColor=\"#23BAA4\" stopOpacity={0.2} />\n                        <stop offset=\"95%\" stopColor=\"#23BAA4\" stopOpacity={0.0} />\n                      </linearGradient>\n                    </defs>\n                    <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#1A1A1A\" strokeOpacity={0.08} />\n                    <XAxis\n                      dataKey=\"month\"\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 12, fontWeight: 600 }}\n                      dy={10}\n                    />\n                    <YAxis\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 11, opacity: 0.6 }}\n                      tickFormatter={(val) => `\342\202\254${val / 1000}k`}\n                    />\n                    <Tooltip\n                      content={({ active, payload, label }) => {\n                        if (active && payload && payload.length) {\n                          return (\n                            <div className=\"bg-[#1A1A1A] text-white p-4 text-xs shadow-2xl border border-white/10 min-w-[200px]\">\n                              <p className=\"font-bold text-[#E56014] uppercase tracking-wider mb-2 border-b border-white/10 pb-1\">\n                                Monat: {label}\n                              </p>\n                              <div className=\"space-y-1.5\">\n                                {payload.map((entry, idx) => (\n                                  <div key={idx} className=\"flex justify-between items-center\">\n                                    <span className=\"text-white/70\">{entry.name}:</span>\n                                    <strong className=\"font-mono text-white\">\n                                      \342\202\254{(entry.value as number)?.toLocaleString(\'de-DE\')}\n                                    </strong>\n                                  </div>\n                                ))}\n                              </div>\n                            </div>\n                          );\n                        }\n                        return null;\n                      }}\n                    />\n                    <Area\n                      type=\"monotone\"\n                      dataKey=\"optimistic\"\n                      name=\"Optimistisches Szenario\"\n                      stroke=\"#23BAA4\"\n                      strokeWidth={2}\n                      strokeDasharray=\"4 4\"\n                      fillOpacity={1}\n                      fill=\"url(#colorOptimistic)\"\n                    />\n                    <Area\n                      type=\"monotone\"\n                      dataKey=\"projected\"\n                      name=\"Erwartete Prognose\"\n                      stroke=\"#E56014\"\n                      strokeWidth={3}\n                      fillOpacity={1}\n                      fill=\"url(#colorProjected)\"\n                    />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"actual\"\n                      name=\"Realisierter Ist-Umsatz\"\n                      stroke=\"#1A1A1A\"\n                      strokeWidth={3}\n                      dot={{ fill: \'#1A1A1A\', r: 5, strokeWidth: 2, stroke: \'#fff\' }}\n                      activeDot={{ r: 7 }}\n                    />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"target\"\n                      name=\"Quartals-Zielvorgabe\"\n                      stroke=\"#9CA3AF\"\n                      strokeWidth={2}\n                      strokeDasharray=\"5 5\"\n                      dot={false}\n                    />\n                  </ComposedChart>\n                </ResponsiveContainer>\n              </div>\n\n              {/* Forecast Insight Summary */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6 pt-6 border-t border-[#1A1A1A]/10 text-xs\">\n                <div className=\"p-4 bg-[#F9F8F6]\">\n                  <span className=\"text-[#1A1A1A]/50 uppercase tracking-wider font-bold block mb-1\">\n                    Zielerreichung (Q3/Q4)\n                  </span>\n                  <span className=\"text-lg font-black text-[#23BAA4]\">+124.6%</span>\n                  <p className=\"text-[11px] text-[#1A1A1A]/60 mt-0.5\">\303\234ber Plan durch konsequentes Follow-Up</p>\n                </div>\n                <div className=\"p-4 bg-[#F9F8F6]\">\n                  <span className=\"text-[#1A1A1A]/50 uppercase tracking-wider font-bold block mb-1\">\n                    Monatlicher Zuwachs\n                  </span>\n                  <span className=\"text-lg font-black text-[#E56014]\">+\342\202\25418.400 / Mo</span>\n                  <p className=\"text-[11px] text-[#1A1A1A]/60 mt-0.5\">Durchschnittliches Wachstumstempo</p>\n                </div>\n                <div className=\"p-4 bg-[#F9F8F6]\">\n                  <span className=\"text-[#1A1A1A]/50 uppercase tracking-wider font-bold block mb-1\">\n                    Gesch\303\244tzter Jahresabschluss\n                  </span>\n                  <span className=\"text-lg font-black text-[#1A1A1A]\">\342\202\2541.48 Mio.</span>\n                  <p className=\"text-[11px] text-[#1A1A1A]/60 mt-0.5\">Gesamtvolumen Neukundengesch\303\244ft</p>\n                </div>\n              </div>\n            </div>\n\n            {/* Interactive Simulation Controls */}\n            <div className=\"lg:col-span-4 bg-[#F9F8F6] border border-[#1A1A1A]/10 p-6 sm:p-8 flex flex-col justify-between\">\n              <div>\n                <div className=\"flex items-center justify-between mb-6 pb-4 border-b border-[#1A1A1A]/10\">\n                  <div className=\"flex items-center gap-2\">\n                    <Sliders className=\"w-4 h-4 text-[#E56014]\" />\n                    <h4 className=\"text-xs uppercase tracking-widest font-bold text-[#1A1A1A]\">\n                      Szenarien-Simulator\n                    </h4>\n                  </div>\n                  <button\n                    onClick={() => {\n                      setLeadBoost(15);\n                      setConvBoost(20);\n                      setDealSizeBoost(10);\n                    }}\n                    className=\"text-[10px] uppercase font-bold tracking-wider text-[#1A1A1A]/50 hover:text-[#E56014] flex items-center gap-1 transition-colors\"\n                  >\n                    <RefreshCw className=\"w-3 h-3\" /> Reset\n                  </button>\n                </div>\n\n                <p className=\"text-xs text-[#1A1A1A]/70 mb-6 leading-relaxed\">\n                  Passen Sie die Hebel an, um sofort die Auswirkungen von LeadPilot-Optimierungen auf Ihren Umsatz zu simulieren:\n                </p>\n\n                {/* Slider 1: Lead Volume */}\n                <div className=\"mb-6\">\n                  <div className=\"flex justify-between text-xs font-bold mb-2\">\n                    <span className=\"text-[#1A1A1A]\">Lead-Volumen Steigerung:</span>\n                    <span className=\"text-[#E56014]\">+{leadBoost}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"50\"\n                    value={leadBoost}\n                    onChange={(e) => setLeadBoost(Number(e.target.value))}\n                    className=\"w-full accent-[#E56014] cursor-pointer h-1.5 bg-[#1A1A1A]/10 rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-[#1A1A1A]/40 mt-1\">\n                    <span>0%</span>\n                    <span>+25%</span>\n                    <span>+50%</span>\n                  </div>\n                </div>\n\n                {/* Slider 2: Conversion Boost */}\n                <div className=\"mb-6\">\n                  <div className=\"flex justify-between text-xs font-bold mb-2\">\n                    <span className=\"text-[#1A1A1A]\">Conversion-Rate Optimierung:</span>\n                    <span className=\"text-[#23BAA4]\">+{convBoost}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"40\"\n                    value={convBoost}\n                    onChange={(e) => setConvBoost(Number(e.target.value))}\n                    className=\"w-full accent-[#23BAA4] cursor-pointer h-1.5 bg-[#1A1A1A]/10 rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-[#1A1A1A]/40 mt-1\">\n                    <span>0% (Status Quo)</span>\n                    <span>+20% (LeadPilot \303\230)</span>\n                    <span>+40%</span>\n                  </div>\n                </div>\n\n                {/* Slider 3: Deal Size */}\n                <div className=\"mb-8\">\n                  <div className=\"flex justify-between text-xs font-bold mb-2\">\n                    <span className=\"text-[#1A1A1A]\">Deal-Gr\303\266\303\237e (Upselling):</span>\n                    <span className=\"text-[#1A1A1A]\">+{dealSizeBoost}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"30\"\n                    value={dealSizeBoost}\n                    onChange={(e) => setDealSizeBoost(Number(e.target.value))}\n                    className=\"w-full accent-[#1A1A1A] cursor-pointer h-1.5 bg-[#1A1A1A]/10 rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-[#1A1A1A]/40 mt-1\">\n                    <span>0%</span>\n                    <span>+15%</span>\n                    <span>+30%</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Simulation Result Card */}\n              <div className=\"p-5 bg-[#1A1A1A] text-white\">\n                <div className=\"flex items-center gap-2 text-[#23BAA4] text-[10px] uppercase font-bold tracking-widest mb-2\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  Kalkulierter Mehrumsatz\n                </div>\n                <div className=\"text-2xl sm:text-3xl font-black tracking-tight text-white mb-1\">\n                  +\342\202\254{Math.round(((totalProjectedARR - 1100000) / 1000)).toLocaleString(\'de-DE\')}k / Jahr\n                </div>\n                <p className=\"text-[11px] text-white/60 leading-normal\">\n                  Zus\303\244tzlicher Ertrag durch strukturierte Wiedervorlage und 0% Lead-Verlust.\n                </p>\n              </div>\n            </div>\n          </motion.div>\n        )}\n\n        {/* Dynamic View Tab 3: Real-Time Active Deals */}\n        {activeTab === \'deals\' && (\n          <motion.div\n            key=\"tab-deals\"\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.4 }}\n            className=\"bg-white border border-[#1A1A1A]/10 overflow-hidden\"\n          >\n            <div className=\"p-6 sm:p-8 border-b border-[#1A1A1A]/10 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n              <div>\n                <h3 className=\"text-xl font-bold tracking-tight text-[#1A1A1A]\">\n                  Echtzeit Lead-Feed & Automatische Aufgaben\n                </h3>\n                <p className=\"text-xs text-[#1A1A1A]/60 mt-1\">\n                  Jeder Lead im System besitzt einen l\303\274ckenlos zugewiesenen n\303\244chsten Schritt.\n                </p>\n              </div>\n              <span className=\"text-xs font-mono font-bold bg-[#F9F8F6] border border-[#1A1A1A]/10 px-3 py-1.5\">\n                4 Deals mit Priorit\303\244t 1\n              </span>\n            </div>\n\n            <div className=\"overflow-x-auto\">\n              <table className=\"w-full text-left text-xs\">\n                <thead>\n                  <tr className=\"bg-[#F9F8F6] border-b border-[#1A1A1A]/10 text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/50\">\n                    <th className=\"py-4 px-6\">ID & Unternehmen</th>\n                    <th className=\"py-4 px-6\">Deal-Wert</th>\n                    <th className=\"py-4 px-6\">Phase</th>\n                    <th className=\"py-4 px-6\">Abschluss-Chance</th>\n                    <th className=\"py-4 px-6\">N\303\244chster automatischer Schritt</th>\n                    <th className=\"py-4 px-6\">Zust\303\244ndig</th>\n                  </tr>\n                </thead>\n                <tbody className=\"divide-y divide-[#1A1A1A]/10\">\n                  {sampleDeals.map((deal) => (\n                    <tr key={deal.id} className=\"hover:bg-[#F9F8F6] transition-colors\">\n                      <td className=\"py-5 px-6 font-bold text-[#1A1A1A]\">\n                        <span className=\"text-[10px] font-mono text-[#1A1A1A]/40 block\">{deal.id}</span>\n                        {deal.company}\n                      </td>\n                      <td className=\"py-5 px-6 font-black font-mono text-sm text-[#E56014]\">\n                        {deal.value}\n                      </td>\n                      <td className=\"py-5 px-6\">\n                        <span className=\"inline-flex items-center px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider bg-[#1A1A1A]/5 text-[#1A1A1A]\">\n                          {deal.stage}\n                        </span>\n                      </td>\n                      <td className=\"py-5 px-6\">\n                        <div className=\"flex items-center gap-2\">\n                          <span className=\"font-bold text-[#23BAA4]\">{deal.prob}</span>\n                          <div className=\"w-16 h-1.5 bg-[#1A1A1A]/10 rounded-full overflow-hidden\">\n                            <div\n                              className=\"h-full bg-[#23BAA4]\"\n                              style={{ width: deal.prob }}\n                            ></div>\n                          </div>\n                        </div>\n                      </td>\n                      <td className=\"py-5 px-6\">\n                        <div className=\"flex items-center gap-2 text-[#1A1A1A] font-medium\">\n                          <span className=\"w-2 h-2 rounded-full bg-[#E56014] shrink-0\"></span>\n                          {deal.nextAction}\n                        </div>\n                      </td>\n                      <td className=\"py-5 px-6 font-semibold text-[#1A1A1A]/70\">\n                        {deal.rep}\n                      </td>\n                    </tr>\n                  ))}\n                </tbody>\n              </table>\n            </div>\n\n            <div className=\"p-6 bg-[#F9F8F6] border-t border-[#1A1A1A]/10 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs\">\n              <div className=\"flex items-center gap-2 text-[#1A1A1A]/60\">\n                <Info className=\"w-4 h-4 text-[#23BAA4]\" />\n                <span>LeadPilot generiert f\303\274r \303\274berf\303\244llige Aktivit\303\244ten automatische Push-Nachrichten an Ihr Vertriebsteam.</span>\n              </div>\n              <a\n                href=\"#preise\"\n                className=\"bg-[#1A1A1A] text-white px-6 py-2.5 text-xs uppercase tracking-widest font-bold hover:bg-[#E56014] transition-colors\"\n              >\n                Pipeline selbst testen\n              </a>\n            </div>\n          </motion.div>\n        )}\n      </div>\n    </section>\n  );\n}\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import { useState, useMemo } from \'react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { motion, AnimatePresence } from \'motion/react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  BarChart,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Bar,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  XAxis,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  YAxis,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  CartesianGrid,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Tooltip,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ResponsiveContainer,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  AreaChart,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Area,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Line,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ComposedChart,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Cell,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  PieChart,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  Pie"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "} from \'recharts\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  TrendingUp,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
