        lines {
          text: "const CustomFunnelTooltip = ({ active, payload }: FunnelTooltipProps) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!active || !payload || !payload.length) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const item = payload[0].payload;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
