        }
        lines {
          text: "  // Dynamic Year-over-Year (YoY) Totals for Revenue Projections"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const totalProjectedAnnual = useMemo(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return dynamicProjections.reduce((acc, curr) => acc + (curr.actual !== null ? curr.actual : curr.projected), 0);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  }, [dynamicProjections]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
