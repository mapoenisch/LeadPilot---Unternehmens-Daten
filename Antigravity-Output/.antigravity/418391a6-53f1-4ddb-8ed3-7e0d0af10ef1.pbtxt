    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "export const impressumContent = (\n  <>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mb-4\">Angaben gem\303\244\303\237 \302\247 5 TMG</h3>\n    <p>\n      LeadPilot Technology Group GmbH<br />\n      Musterstra\303\237e 123<br />\n      10115 Berlin<br />\n      Deutschland\n    </p>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mt-8 mb-4\">Vertreten durch</h3>\n    <p>Gesch\303\244ftsf\303\274hrer: Max Mustermann</p>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mt-8 mb-4\">Kontakt</h3>\n    <p>\n      Telefon: +49 (0) 30 12345678<br />\n      E-Mail: kontakt@leadpilot-dummy.de\n    </p>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mt-8 mb-4\">Umsatzsteuer-ID</h3>\n    <p>Umsatzsteuer-Identifikationsnummer gem\303\244\303\237 \302\247 27 a Umsatzsteuergesetz:<br />DE 999 999 999</p>\n  </>\n);\n\nexport const datenschutzContent = (\n  <>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mb-4\">1. Datenschutz auf einen Blick</h3>\n    <p><strong>Allgemeine Hinweise</strong></p>\n    <p>Die folgenden Hinweise geben einen einfachen \303\234berblick dar\303\274ber, was mit Ihren personenbezogenen Daten passiert, wenn Sie diese Website besuchen.</p>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mt-8 mb-4\">2. Datenerfassung auf dieser Website</h3>\n    <p><strong>Wer ist verantwortlich f\303\274r die Datenerfassung?</strong></p>\n    <p>Die Datenverarbeitung auf dieser Website erfolgt durch den Websitebetreiber. Dessen Kontaktdaten k\303\266nnen Sie dem Impressum dieser Website entnehmen.</p>\n    <p><strong>Wie erfassen wir Ihre Daten?</strong></p>\n    <p>Ihre Daten werden zum einen dadurch erhoben, dass Sie uns diese mitteilen. Hierbei kann es sich z. B. um Daten handeln, die Sie in ein Kontaktformular eingeben.</p>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mt-8 mb-4\">3. Hosting und Content Delivery Networks (CDN)</h3>\n    <p>Diese Website wird bei einem externen Dienstleister gehostet (Hoster). Die personenbezogenen Daten, die auf dieser Website erfasst werden, werden auf den Servern des Hosters gespeichert.</p>\n  </>\n);\n\nexport const agbContent = (\n  <>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mb-4\">1. Geltungsbereich</h3>\n    <p>Diese Allgemeinen Gesch\303\244ftsbedingungen (AGB) gelten f\303\274r alle Vertr\303\244ge, die zwischen der LeadPilot Technology Group GmbH und ihren Kunden \303\274ber die Nutzung der LeadPilot Software-as-a-Service (SaaS) Plattform geschlossen werden.</p>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mt-8 mb-4\">2. Leistungen</h3>\n    <p>LeadPilot stellt dem Kunden die Software in der jeweils aktuellen Version \303\274ber das Internet zur Verf\303\274gung. Der genaue Leistungsumfang ergibt sich aus der Leistungsbeschreibung.</p>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mt-8 mb-4\">3. Nutzungsrechte</h3>\n    <p>Der Kunde erh\303\244lt ein nicht ausschlie\303\237liches, zeitlich auf die Laufzeit des Vertrages beschr\303\244nktes, nicht \303\274bertragbares Recht, die Software f\303\274r eigene interne Gesch\303\244ftszwecke zu nutzen.</p>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mt-8 mb-4\">4. Verg\303\274tung und Zahlungsbedingungen</h3>\n    <p>Die Verg\303\274tung richtet sich nach den im Vertrag vereinbarten Preisen. Alle Preise verstehen sich zuz\303\274glich der gesetzlichen Umsatzsteuer. Rechnungen sind innerhalb von 14 Tagen f\303\244llig.</p>\n  </>\n);\n\nexport const blogContent = (\n  <div className=\"grid md:grid-cols-2 gap-8\">\n    <div className=\"border border-[#1A1A1A]/10 p-6 bg-white hover:border-[#1A1A1A] transition-colors cursor-pointer group\">\n      <div className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/50 mb-4\">Vertriebsstrategie</div>\n      <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mb-4 group-hover:text-black\">5 Wege, um die Follow-up-Rate im B2B zu verdoppeln</h3>\n      <p className=\"text-sm text-[#1A1A1A]/70 mb-6\">Erfahren Sie, warum die meisten Leads nach dem ersten Kontakt erkalten und wie Automation hier Abhilfe schafft.</p>\n      <span className=\"text-xs uppercase tracking-widest font-bold border-b border-[#1A1A1A] pb-1\">Weiterlesen</span>\n    </div>\n    <div className=\"border border-[#1A1A1A]/10 p-6 bg-white hover:border-[#1A1A1A] transition-colors cursor-pointer group\">\n      <div className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/50 mb-4\">CRM & Tools</div>\n      <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mb-4 group-hover:text-black\">Warum Excel kein CRM ist</h3>\n      <p className=\"text-sm text-[#1A1A1A]/70 mb-6\">Ab wann Spreadsheets Ihr Wachstum bremsen und wie der Wechsel zu einem echten CRM gelingt.</p>\n      <span className=\"text-xs uppercase tracking-widest font-bold border-b border-[#1A1A1A] pb-1\">Weiterlesen</span>\n    </div>\n    <div className=\"border border-[#1A1A1A]/10 p-6 bg-white hover:border-[#1A1A1A] transition-colors cursor-pointer group\">\n      <div className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/50 mb-4\">KI im Sales</div>\n      <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mb-4 group-hover:text-black\">KI-gest\303\274tztes Lead Scoring</h3>\n      <p className=\"text-sm text-[#1A1A1A]/70 mb-6\">Wie Algorithmen heute schon erkennen, welcher Lead die h\303\266chste Abschlusswahrscheinlichkeit hat.</p>\n      <span className=\"text-xs uppercase tracking-widest font-bold border-b border-[#1A1A1A] pb-1\">Weiterlesen</span>\n    </div>\n  </div>\n);\n\nexport const webinarContent = (\n  <>\n    <div className=\"bg-white border border-[#1A1A1A]/10 p-8 mb-8 flex flex-col md:flex-row gap-8 items-center justify-between\">\n      <div>\n        <span className=\"inline-block bg-[#1A1A1A] text-white text-[10px] uppercase tracking-widest font-bold px-3 py-1 mb-4\">Live am 15. August</span>\n        <h3 className=\"text-2xl font-serif italic text-[#1A1A1A] mb-2\">Automated Sales Masterclass</h3>\n        <p className=\"text-sm text-[#1A1A1A]/70\">Lernen Sie in 45 Minuten, wie Sie Ihre Sales-Pipeline vollst\303\244ndig automatisieren.</p>\n      </div>\n      <button className=\"shrink-0 bg-transparent border border-[#1A1A1A] text-[#1A1A1A] hover:bg-[#1A1A1A] hover:text-white px-6 py-3 text-xs uppercase tracking-widest font-bold transition-colors\">\n        Kostenlos Anmelden\n      </button>\n    </div>\n    <h3 className=\"text-xl font-serif italic text-[#1A1A1A] mt-12 mb-6\">On-Demand Webinare</h3>\n    <div className=\"grid md:grid-cols-2 gap-8\">\n      <div className=\"border border-[#1A1A1A]/10 p-6 bg-white\">\n        <h4 className=\"font-bold mb-2\">CRM Migration f\303\274r Einsteiger</h4>\n        <p className=\"text-sm text-[#1A1A1A]/70 mb-4\">Von Excel zu LeadPilot in unter 2 Stunden.</p>\n        <span className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A] underline\">Aufzeichnung ansehen</span>\n      </div>\n      <div className=\"border border-[#1A1A1A]/10 p-6 bg-white\">\n        <h4 className=\"font-bold mb-2\">B2B Kaltakquise 2.0</h4>\n        <p className=\"text-sm text-[#1A1A1A]/70 mb-4\">Wie Automation Ihre Kaltakquise w\303\244rmer macht.</p>\n        <span className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A] underline\">Aufzeichnung ansehen</span>\n      </div>\n    </div>\n  </>\n);\n\nexport const helpCenterContent = (\n  <>\n    <div className=\"mb-8\">\n      <input \n        type=\"text\" \n        placeholder=\"Wie k\303\266nnen wir helfen? (z.B. \'Passwort zur\303\274cksetzen\')\" \n        className=\"w-full bg-white border border-[#1A1A1A]/20 px-6 py-4 text-sm focus:outline-none focus:border-[#1A1A1A] transition-colors placeholder:text-[#1A1A1A]/40 font-serif italic\"\n      />\n    </div>\n    <div className=\"grid md:grid-cols-2 gap-8\">\n      <div>\n        <h3 className=\"text-lg font-serif italic text-[#1A1A1A] mb-4\">Erste Schritte</h3>\n        <ul className=\"space-y-3\">\n          <li><a href=\"#\" className=\"text-sm text-[#1A1A1A]/70 hover:text-[#1A1A1A] hover:underline\">Account einrichten</a></li>\n          <li><a href=\"#\" className=\"text-sm text-[#1A1A1A]/70 hover:text-[#1A1A1A] hover:underline\">Teammitglieder einladen</a></li>\n          <li><a href=\"#\" className=\"text-sm text-[#1A1A1A]/70 hover:text-[#1A1A1A] hover:underline\">Leads importieren (CSV)</a></li>\n        </ul>\n      </div>\n      <div>\n        <h3 className=\"text-lg font-serif italic text-[#1A1A1A] mb-4\">Automation</h3>\n        <ul className=\"space-y-3\">\n          <li><a href=\"#\" className=\"text-sm text-[#1A1A1A]/70 hover:text-[#1A1A1A] hover:underline\">Workflows erstellen</a></li>\n          <li><a href=\"#\" className=\"text-sm text-[#1A1A1A]/70 hover:text-[#1A1A1A] hover:underline\">E-Mail-Sequenzen planen</a></li>\n          <li><a href=\"#\" className=\"text-sm text-[#1A1A1A]/70 hover:text-[#1A1A1A] hover:underline\">Lead-Scoring konfigurieren</a></li>\n        </ul>\n      </div>\n    </div>\n    <div className=\"mt-12 bg-white border border-[#1A1A1A]/10 p-6 text-center\">\n      <h3 className=\"font-serif italic text-lg mb-2\">Nichts gefunden?</h3>\n      <p className=\"text-sm text-[#1A1A1A]/70 mb-4\">Unser Support-Team ist von Mo-Fr (9-17 Uhr) f\303\274r Sie da.</p>\n      <button className=\"bg-[#1A1A1A] text-white px-6 py-3 text-xs uppercase tracking-widest font-bold hover:bg-[#333] transition-colors\">\n        Ticket er\303\266ffnen\n      </button>\n    </div>\n  </>\n);\n\nexport const customerCasesContent = (\n  <>\n    <div className=\"grid md:grid-cols-2 gap-8\">\n      <div className=\"bg-white border border-[#1A1A1A]/10 p-8 flex flex-col justify-between h-full\">\n        <div>\n          <span className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/50 mb-4 block\">Software & IT</span>\n          <h3 className=\"text-2xl font-serif italic text-[#1A1A1A] mb-4\">Wie CloudNova ihre Sales-Zyklen um 40% verk\303\274rzt hat</h3>\n          <p className=\"text-sm text-[#1A1A1A]/70 mb-8\">Durch die Einf\303\274hrung automatischer Follow-ups konnte CloudNova nicht nur die Conversion-Rate steigern, sondern auch die Zeit bis zum Abschluss drastisch reduzieren.</p>\n        </div>\n        <button className=\"self-start text-xs uppercase tracking-widest font-bold border-b border-[#1A1A1A] pb-1 hover:text-[#1A1A1A]/60 transition-colors\">\n          Case Study lesen\n        </button>\n      </div>\n      <div className=\"bg-white border border-[#1A1A1A]/10 p-8 flex flex-col justify-between h-full\">\n        <div>\n          <span className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/50 mb-4 block\">Logistik</span>\n          <h3 className=\"text-2xl font-serif italic text-[#1A1A1A] mb-4\">TransCargo verdoppelt Lead-Kapazit\303\244t ohne neues Personal</h3>\n          <p className=\"text-sm text-[#1A1A1A]/70 mb-8\">Das 5-k\303\266pfige Sales-Team von TransCargo kann dank LeadPilot nun doppelt so viele Inbound-Leads qualifizieren wie zuvor im alten System.</p>\n        </div>\n        <button className=\"self-start text-xs uppercase tracking-widest font-bold border-b border-[#1A1A1A] pb-1 hover:text-[#1A1A1A]/60 transition-colors\">\n          Case Study lesen\n        </button>\n      </div>\n    </div>\n  </>\n);\n"
    }
