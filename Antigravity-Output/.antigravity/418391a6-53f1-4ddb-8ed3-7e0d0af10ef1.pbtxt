        lines {
          text: "export function CRMDashboard() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [activeTab, setActiveTab] = useState<\'funnel\' | \'forecast\' | \'deals\'>(\'funnel\');"
