        }
        lines {
          text: "  }, [isSimulating, leadBoost, convBoost, dealSizeBoost]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
