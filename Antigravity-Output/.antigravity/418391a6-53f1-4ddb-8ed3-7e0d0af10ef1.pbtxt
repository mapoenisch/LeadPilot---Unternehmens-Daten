      target_content: "    <section id=\"preise\" className=\"py-24 bg-white\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center max-w-3xl mx-auto mb-16\">\n          <h2 className=\"text-3xl md:text-4xl font-bold text-slate-900 mb-4\">\n            Einfache Preise f\303\274r Ihren Erfolg\n          </h2>\n          <p className=\"text-lg text-slate-600\">\n            Jeder verlorene Lead kostet mehr als unsere Software. Investieren Sie in Struktur, die sich ab Tag 1 auszahlt.\n          </p>\n        </div>\n\n        <div className=\"grid md:grid-cols-3 gap-8 items-stretch\">\n          {tiers.map((tier, index) => (\n            <motion.div\n              key={index}\n              className={`relative flex flex-col p-8 rounded-2xl border ${\n                tier.highlighted \n                  ? \'border-teal-600 shadow-lg\' \n                  : \'border-slate-200 shadow-sm\'\n              }`}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.4, delay: index * 0.1 }}\n            >\n              {tier.highlighted && (\n                <div className=\"absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2\">\n                  <span className=\"bg-teal-600 text-white text-xs font-bold uppercase tracking-wider py-1 px-3 rounded-full\">\n                    Am beliebtesten\n                  </span>\n                </div>\n              )}\n              \n              <div className=\"mb-8\">\n                <h3 className=\"text-xl font-bold text-slate-900 mb-2\">{tier.name}</h3>\n                <p className=\"text-slate-500 text-sm h-10\">{tier.description}</p>\n              </div>\n              \n              <div className=\"mb-8\">\n                <div className=\"flex items-baseline gap-1\">\n                  {tier.price !== \'Individuell\' && <span className=\"text-2xl font-bold text-slate-900\">\342\202\254</span>}\n                  <span className=\"text-4xl font-extrabold text-slate-900\">{tier.price}</span>\n                  {tier.price !== \'Individuell\' && <span className=\"text-slate-500\">/Nutzer/Monat</span>}\n                </div>\n              </div>\n              \n              <ul className=\"space-y-4 mb-8 flex-grow\">\n                {tier.features.map((feature, fIndex) => (\n                  <li key={fIndex} className=\"flex items-start gap-3\">\n                    <CheckCircle2 className={`h-5 w-5 shrink-0 ${tier.highlighted ? \'text-teal-600\' : \'text-slate-400\'}`} />\n                    <span className=\"text-slate-600\">{feature}</span>\n                  </li>\n                ))}\n              </ul>\n              \n              <button \n                className={`w-full py-3 px-6 rounded-lg font-medium transition-colors ${\n                  tier.highlighted \n                    ? \'bg-teal-600 text-white hover:bg-teal-700\' \n                    : \'bg-slate-100 text-slate-900 hover:bg-slate-200\'\n                }`}\n              >\n                {tier.cta}\n              </button>\n            </motion.div>\n          ))}\n        </div>\n      </div>\n    </section>"
      replacement_content: "    <section id=\"preise\" className=\"py-32 bg-white border-b border-[#1A1A1A]/10\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-10\">\n        <div className=\"flex flex-col md:flex-row justify-between items-end mb-20 gap-8\">\n          <div className=\"max-w-2xl\">\n            <h2 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-[#1A1A1A]/50\">Investment</h2>\n            <h3 className=\"text-[40px] md:text-[60px] leading-[0.9] font-black uppercase tracking-tighter\">\n              Einfache<br /><span className=\"font-serif italic font-normal tracking-normal text-[#1A1A1A]/40\">Preise.</span>\n            </h3>\n          </div>\n          <div className=\"max-w-sm pb-2 border-b border-[#1A1A1A]/10\">\n            <p className=\"text-sm leading-relaxed text-[#1A1A1A]/70\">\n              Jeder verlorene Lead kostet mehr als unsere Software. Investieren Sie in Struktur, die sich ab Tag 1 auszahlt.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"grid md:grid-cols-3 border-t border-l border-[#1A1A1A]/10\">\n          {tiers.map((tier, index) => (\n            <motion.div\n              key={index}\n              className={`relative flex flex-col p-12 border-b border-r border-[#1A1A1A]/10 ${\n                tier.highlighted \n                  ? \'bg-[#F9F8F6]\' \n                  : \'bg-white\'\n              }`}\n              initial={{ opacity: 0 }}\n              whileInView={{ opacity: 1 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.4, delay: index * 0.1 }}\n            >\n              {tier.highlighted && (\n                <div className=\"absolute top-0 right-0 bg-[#1A1A1A] text-white text-[10px] font-bold uppercase tracking-widest py-2 px-4\">\n                  Am beliebtesten\n                </div>\n              )}\n              \n              <div className=\"mb-12 border-b border-[#1A1A1A]/10 pb-8\">\n 