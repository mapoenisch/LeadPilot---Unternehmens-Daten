          text: "  const avgDealValuePerLead = item.leads > 0 ? Math.round(item.value / item.leads) : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const hasYoy = item.previousYearLeads !== undefined && item.previousYearLeads > 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const yoyLeadDiff = hasYoy ? item.leads - item.previousYearLeads! : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const yoyLeadPct = hasYoy ? ((yoyLeadDiff / item.previousYearLeads!) * 100).toFixed(1) : \'0.0\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
