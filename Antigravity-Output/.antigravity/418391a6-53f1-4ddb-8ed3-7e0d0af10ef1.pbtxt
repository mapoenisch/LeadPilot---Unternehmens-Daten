          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                              <div className=\"text-2xl font-serif italic mb-1\">100%</div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                              <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/70\">Transparenz im Sales-Funnel</div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            </li>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                          </ul>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
