        }
        lines {
          text: "export function CRMDashboard() {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [activeTab, setActiveTab] = useState<\'funnel\' | \'forecast\' | \'deals\'>(\'funnel\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [timeRange, setTimeRange] = useState<\'30d\' | \'90d\' | \'12m\'>(\'90d\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [selectedStage, setSelectedStage] = useState<StageData>(basePipelineStages[0]);"
