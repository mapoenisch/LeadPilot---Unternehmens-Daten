        }
        lines {
          text: "// Trigger direct browser CSV download with UTF-8 BOM for Excel compatibility"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "export const downloadCSVFile = (csvContent: string, filename: string) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const BOM = \'\\uFEFF\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const blob = new Blob([BOM + csvContent], { type: \'text/csv;charset=utf-8;\' });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const url = URL.createObjectURL(blob);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const link = document.createElement(\'a\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  link.setAttribute(\'href\', url);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  link.setAttribute(\'download\', filename.endsWith(\'.csv\') ? filename : `${filename}.csv`);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  document.body.appendChild(link);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  link.click();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  document.body.removeChild(link);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  URL.revokeObjectURL(url);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "};"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
