        }
        lines {
          text: "          <td class=\"text-right mono\" style=\"color: #23BAA4;\">${stg.conversionRate}%</td>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <td class=\"text-right mono\">${stg.avgDays} Tage</td>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <td>${stg.topChannels[0]?.channel || \'Direkt\'} (${stg.topChannels[0]?.share || \'100%\'})</td>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        </tr>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
