  file_change {
    absolute_path_uri: "file:///src/components/Pricing.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "const tiers = [\n  {\n    name: \'Starter\',\n    price: \'49\',\n    description: \'F\303\274r kleine Teams, die Excel hinter sich lassen wollen.\',\n    features: [\n      \'1\342\200\22310 Nutzer\',\n      \'Zentrale Lead-Erfassung\',\n      \'Automatische Aufgaben-Zuweisung\',\n      \'Basis-Dashboard & Pipeline\',\n      \'E-Mail-Support\'\n    ],\n    highlighted: false,\n    cta: \'Kostenlos testen\'\n  },\n  {\n    name: \'Growth\',\n    price: \'89\',\n    description: \'F\303\274r wachsende Teams mit Fokus auf KI und Effizienz.\',\n    features: [\n      \'10\342\200\22350 Nutzer\',\n      \'Alles aus Starter\',\n      \'KI-Lead-Scoring\',\n      \'Erweiterte Automatisierungen\',\n      \'Pers\303\266nliches Onboarding\'\n    ],\n    highlighted: true,\n    cta: \'Kostenlos testen\'\n  },\n  {\n    name: \'Pro\',\n    price: \'Individuell\',\n    description: \'F\303\274r etablierte Vertriebsorganisationen.\',\n    features: [\n      \'50+ Nutzer\',\n      \'Erweiterte Integrationen\',\n      \'Individuelle Rollen & Rechte\',\n      \'Dedizierter Customer Success\',\n      \'SLA & API-Zugang\'\n    ],\n    highlighted: false,\n    cta: \'Vertrieb kontaktieren\'\n  }\n];\n\nexport function Pricing() {\n  const [isSignupOpen, setIsSignupOpen] = useState(false);\n  const [selectedPlan, setSelectedPlan] = useState(\"\");\n\n  const handlePlanClick = (planName: string) => {\n    setSelectedPlan(planName);\n    setIsSignupOpen(true);\n  };\n\n  return (\n    <>\n      <section id=\"preise\" className=\"py-32 bg-white border-b border-[#1A1A1A]/10\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-10\">\n          <div className=\"flex flex-col md:flex-row justify-between items-end mb-20 gap-8\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-[#1A1A1A]/50\">Investment</h2>\n              <h3 className=\"text-[40px] md:text-[60px] leading-[0.9] font-black uppercase tracking-tighter\">\n                Einfache<br /><span className=\"font-serif italic font-normal tracking-normal text-[#1A1A1A]/40\">Preise.</span>\n              </h3>\n            </div>\n            <div className=\"max-w-sm pb-2 border-b border-[#1A1A1A]/10\">\n              <p className=\"text-sm leading-relaxed text-[#1A1A1A]/70\">\n                Jeder verlorene Lead kostet mehr als unsere Software. Investieren Sie in Struktur, die sich ab Tag 1 auszahlt.\n              </p>\n            </div>\n          </div>\n\n          <div className=\"grid md:grid-cols-3 border-t border-l border-[#1A1A1A]/10\">\n            {tiers.map((tier, index) => (\n              <motion.div\n                key={index}\n                className={`relative flex flex-col p-12 border-b border-r border-[#1A1A1A]/10 ${\n                  tier.highlighted \n                    ? \'bg-[#F9F8F6]\' \n                    : \'bg-white\'\n                }`}\n                initial={{ opacity: 0 }}\n                whileInView={{ opacity: 1 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.4, delay: index * 0.1 }}\n              >\n                {tier.highlighted && (\n                  <div className=\"absolute top-0 right-0 bg-[#1A1A1A] text-white text-[10px] font-bold uppercase tracking-widest py-2 px-4\">\n                    Am beliebtesten\n                  </div>\n                )}\n                \n                <div className=\"mb-12 border-b border-[#1A1A1A]/10 pb-8\">\n                  <h4 className=\"text-2xl font-serif italic mb-4\">{tier.name}</h4>\n                  <p className=\"text-sm text-[#1A1A1A]/60 min-h-[40px]\">{tier.description}</p>\n                </div>\n                \n                <div className=\"mb-12\">\n                  <div className=\"flex items-start gap-1\">\n                    {tier.price !== \'Individuell\' && <span className=\"text-xl font-medium mt-1\">\342\202\254</span>}\n                    <span className=\"text-[64px] font-black tracking-tighter leading-none\">{tier.price}</span>\n                  </div>\n                  {tier.price !== \'Individuell\' && <div className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/40 mt-2\">/ Nutzer / Monat</div>}\n                </div>\n                \n                <ul className=\"space-y-6 mb-12 flex-grow\">\n                  {tier.features.map((feature, fIndex) => (\n                    <li key={fIndex} className=\"flex items-start gap-4\">\n                      <span className=\"w-1.5 h-1.5 bg-[#1A1A1A] rounded-full mt-2 shrink-0\"></span>\n                      <span className=\"text-sm text-[#1A1A1A]/80\">{feature}</span>\n                    </li>\n                  ))}\n                </ul>\n                \n                <button \n                  onClick={() => handlePlanClick(`${tier.name} Plan`)}\n                  className={`w-full py-5 text-xs uppercase tracking-widest font-bold transition-colors ${\n                    tier.highlighted \n                      ? \'bg-[#1A1A1A] text-white hover:bg-[#333]\' \n                      : \'bg-transparent border border-[#1A1A1A] text-[#1A1A1A] hover:bg-[#1A1A1A] hover:text-white\'\n                  }`}\n                >\n                  {tier.cta}\n                </button>\n              </motion.div>\n            ))}\n          </div>"
      replacement_content: "const tiers = [\n  {\n    name: \'Starter\',\n    priceMonthly: \'49\',\n    priceAnnual: \'39\',\n    description: \'F\303\274r kleine Teams, die Excel hinter sich lassen wollen.\',\n    features: [\n      \'1\342\200\22310 Nutzer\',\n      \'Zentrale Lead-Erfassung\',\n      \'Automatische Aufgaben-Zuweisung\',\n      \'Basis-Dashboard & Pipeline\',\n      \'E-Mail-Support\'\n    ],\n    highlighted: false,\n    cta: \'Kostenlos testen\'\n  },\n  {\n    name: \'Growth\',\n    priceMonthly: \'89\',\n    priceAnnual: \'75\',\n    description: \'F\303\274r wachsende Teams mit Fokus auf KI und Effizienz.\',\n    features: [\n      \'10\342\200\22350 Nutzer\',\n      \'Alles aus Starter\',\n      \'KI-Lead-Scoring\',\n      \'Erweiterte Automatisierungen\',\n      \'Pers\303\266nliches Onboarding\'\n    ],\n    highlighted: true,\n    cta: \'Kostenlos testen\'\n  },\n  {\n    name: \'Pro\',\n    priceMonthly: \'Individuell\',\n    priceAnnual: \'Individuell\',\n    description: \'F\303\274r etablierte Vertriebsorganisationen.\',\n    features: [\n      \'50+ Nutzer\',\n      \'Erweiterte Integrationen\',\n      \'Individuelle Rollen & Rechte\',\n      \'Dedizierter Customer Success\',\n      \'SLA & API-Zugang\'\n    ],\n    highlighted: false,\n    cta: \'Vertrieb kontaktieren\'\n  }\n];\n\nexport function Pricing() {\n  const [isSignupOpen, setIsSignupOpen] = useState(false);\n  const [selectedPlan, setSelectedPlan] = useState(\"\");\n  const [isAnnual, setIsAnnual] = useState(true);\n\n  const handlePlanClick = (planName: string) => {\n    setSelectedPlan(planName);\n    setIsSignupOpen(true);\n  };\n\n  return (\n    <>\n      <section id=\"preise\" className=\"py-32 bg-white border-b border-[#1A1A1A]/10\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-10\">\n          <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-20 gap-8\">\n            <div className=\"max-w-2xl\">\n              <h2 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-[#1A1A1A]/50\">Investment</h2>\n              <h3 className=\"text-[40px] md:text-[60px] leading-[0.9] font-black uppercase tracking-tighter mb-8 md:mb-0\">\n                Einfache<br /><span className=\"font-serif italic font-normal tracking-normal text-[#1A1A1A]/40\">Preise.</span>\n              </h3>\n            </div>\n            <div className=\"flex flex-col items-start md:items-end gap-8\">\n              <div className=\"flex items-center p-1 bg-[#F9F8F6] border border-[#1A1A1A]/10\">\n                <button\n                  onClick={() => setIsAnnual(false)}\n                  className={`px-6 py-3 text-xs uppercase tracking-widest font-bold transition-colors ${\n                    !isAnnual ? \'bg-[#1A1A1A] text-white\' : \'text-[#1A1A1A]/60 hover:text-[#1A1A1A]\'\n                  }`}\n                >\n                  Monatlich\n                </button>\n                <button\n                  onClick={() => setIsAnnual(true)}\n                  className={`px-6 py-3 text-xs uppercase tracking-widest font-bold transition-colors flex items-center gap-2 ${\n                    isAnnual ? \'bg-[#1A1A1A] text-white\' : \'text-[#1A1A1A]/60 hover:text-[#1A1A1A]\'\n                  }`}\n                >\n                  J\303\244hrlich <span className={`text-[10px] px-2 py-0.5 rounded-full ${isAnnual ? \'bg-white/20\' : \'bg-[#1A1A1A]/10 text-[#1A1A1A]\'}`}>-20%</span>\n                </button>\n              </div>\n              <div className=\"max-w-sm pb-2 border-b border-[#1A1A1A]/10 md:text-right\">\n                <p className=\"text-sm leading-relaxed text-[#1A1A1A]/70\">\n                  Jeder verlorene Lead kostet mehr als unsere Software. Investieren Sie in Struktur, die sich ab Tag 1 auszahlt.\n                </p>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"grid md:grid-cols-3 border-t border-l border-[#1A1A1A]/10\">\n            {tiers.map((tier, index) => {\n              const currentPrice = isAnnual ? tier.priceAnnual : tier.priceMonthly;\n              return (\n              <motion.div\n                key={index}\n                className={`relative flex flex-col p-12 border-b border-r border-[#1A1A1A]/10 ${\n                  tier.highlighted \n                    ? \'bg-[#F9F8F6]\' \n                    : \'bg-white\'\n                }`}\n                initial={{ opacity: 0 }}\n                whileInView={{ opacity: 1 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.4, delay: index * 0.1 }}\n              >\n                {tier.highlighted && (\n                  <div className=\"absolute top-0 right-0 bg-[#1A1A1A] text-white text-[10px] font-bold uppercase tracking-widest py-2 px-4\">\n                    Am beliebtesten\n                  </div>\n                )}\n                \n                <div className=\"mb-12 border-b border-[#1A1A1A]/10 pb-8\">\n                  <h4 className=\"text-2xl font-serif italic mb-4\">{tier.name}</h4>\n                  <p className=\"text-sm text-[#1A1A1A]/60 min-h-[40px]\">{tier.description}</p>\n                </div>\n                \n                <div className=\"mb-12\">\n                  <div className=\"flex items-start gap-1\">\n                    {currentPrice !== \'Individuell\' && <span className=\"text-xl font-medium mt-1\">\342\202\254</span>}\n                    <motion.span \n                      key={currentPrice}\n                      initial={{ opacity: 0, y: -10 }}\n                      animate={{ opacity: 1, y: 0 }}\n                      className=\"text-[64px] font-black tracking-tighter leading-none\"\n                    >\n                      {currentPrice}\n                    </motion.span>\n                  </div>\n                  {currentPrice !== \'Individuell\' && <div className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/40 mt-2\">/ Nutzer / Monat</div>}\n                </div>\n                \n                <ul className=\"space-y-6 mb-12 flex-grow\">\n                  {tier.features.map((feature, fIndex) => (\n                    <li key={fIndex} className=\"flex items-start gap-4\">\n                      <span className=\"w-1.5 h-1.5 bg-[#1A1A1A] rounded-full mt-2 shrink-0\"></span>\n                      <span className=\"text-sm text-[#1A1A1A]/80\">{feature}</span>\n                    </li>\n                  ))}\n                </ul>\n                \n                <button \n                  onClick={() => handlePlanClick(`${tier.name} Plan`)}\n                  className={`w-full py-5 text-xs uppercase tracking-widest font-bold transition-colors ${\n                    tier.highlighted \n                      ? \'bg-[#1A1A1A] text-white hover:bg-[#333]\' \n                      : \'bg-transparent border border-[#1A1A1A] text-[#1A1A1A] hover:bg-[#1A1A1A] hover:text-white\'\n                  }`}\n                >\n                  {tier.cta}\n                </button>\n              </motion.div>\n            )})}\n          </div>"
    }
