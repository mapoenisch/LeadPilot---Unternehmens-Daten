    instruction: "Add export modal state and exportDataPayload in CRMDashboard"
    replacement_infos {
      original_chunk {
        target_content: "  // Export CSV State\n  const [isExporting, setIsExporting] = useState<boolean>(false);\n  const [exportSuccess, setExportSuccess] = useState<boolean>(false);\n\n  // CSV Export Handler\n  const handleExportCSV = () => {\n    setIsExporting(true);\n\n    let csvContent = \'\';\n    let filename = `leadpilot-crm-${activeTab}-${timeRange}-${new Date().toISOString().split(\'T\')[0]}.csv`;\n\n    if (activeTab === \'funnel\') {\n      // Export Funnel Pipeline Stage Metrics\n      const headers = [\'Stufe ID\', \'Phasen-Bezeichnung\', \'Kurzname\', \'Anzahl Leads\', \'Pipeline Wert (EUR)\', \'Conversion Rate (%)\', \'Verweildauer (Tage)\', \'Drop-Off Rate (%)\'];\n      const rows = calculatedStages.map((stage) => [\n        `\"${stage.id}\"`,\n        `\"${stage.stage.replace(/\"/g, \'\"\"\')}\"`,\n        `\"${stage.shortName}\"`,\n        stage.leads,\n        stage.value,\n        stage.conversionRate,\n        stage.avgDays,\n        stage.dropOffRate\n      ]);\n      csvContent = [headers.join(\';\'), ...rows.map((row) => row.join(\';\'))].join(\'\\r\\n\');\n    } else if (activeTab === \'forecast\') {\n      // Export Forecast Projections\n      const headers = [\'Monat\', \'Realisierter Ist-Umsatz (EUR)\', \'Prognose MRR (EUR)\', \'Optimistisches Szenario (EUR)\', \'Baseline (EUR)\', \'Zielvorgabe (EUR)\'];\n      const rows = dynamicProjections.map((item) => [\n        `\"${item.month}\"`,\n        item.actual !== null ? item.actual : \'\',\n        item.projected,\n        item.optimistic,\n        item.baseline,\n        item.target\n      ]);\n      csvContent = [headers.join(\';\'), ...rows.map((row) => row.join(\';\'))].join(\'\\r\\n\');\n    } else {\n      // Export Live Deals\n      const headers = [\'Deal ID\', \'Unternehmen\', \'Deal-Wert\', \'Aktuelle Phase\', \'Abschluss-Wahrscheinlichkeit\', \'Zust\303\244ndiger Vertriebler\', \'N\303\244chster automatischer Schritt\', \'Status\'];\n      const rows = sampleDeals.map((deal) => [\n        `\"${deal.id}\"`,\n        `\"${deal.company.replace(/\"/g, \'\"\"\')}\"`,\n        `\"${deal.value}\"`,\n        `\"${deal.stage.replace(/\"/g, \'\"\"\')}\"`,\n        `\"${deal.prob}\"`,\n        `\"${deal.rep}\"`,\n        `\"${deal.nextAction.replace(/\"/g, \'\"\"\')}\"`,\n        `\"${deal.status}\"`\n      ]);\n      csvContent = [headers.join(\';\'), ...rows.map((row) => row.join(\';\'))].join(\'\\r\\n\');\n    }\n\n    // Add BOM for proper UTF-8 handling in Excel\n    const blob = new Blob([\'\\uFEFF\' + csvContent], { type: \'text/csv;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.setAttribute(\'href\', url);\n    link.setAttribute(\'download\', filename);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    URL.revokeObjectURL(url);\n\n    setIsExporting(false);\n    setExportSuccess(true);\n    setTimeout(() => {\n      setExportSuccess(false);\n    }, 2500);\n  };"
        replacement_content: "  // Export Modal & CSV State\n  const [isExportModalOpen, setIsExportModalOpen] = useState<boolean>(false);\n  const [isExporting, setIsExporting] = useState<boolean>(false);\n  const [exportSuccess, setExportSuccess] = useState<boolean>(false);\n\n  // Quick Direct CSV Export Handler\n  const handleQuickExportCSV = () => {\n    setIsExporting(true);\n\n    let csvContent = \'\';\n    const timestamp = new Date().toISOString().split(\'T\')[0];\n    let filename = `leadpilot-crm-${activeTab}-${timeRange}-${timestamp}.csv`;\n\n    if (activeTab === \'funnel\') {\n      csvContent = generateFunnelCSV(exportDataPayload);\n    } else if (activeTab === \'forecast\') {\n      csvContent = generateForecastCSV(exportDataPayload);\n    } else {\n      csvContent = generateDealsCSV(exportDataPayload);\n    }\n\n    downloadCSVFile(csvContent, filename);\n\n    setIsExporting(false);\n    setExportSuccess(true);\n    setTimeout(() => {\n      setExportSuccess(false);\n    }, 2500);\n  };"
      }
