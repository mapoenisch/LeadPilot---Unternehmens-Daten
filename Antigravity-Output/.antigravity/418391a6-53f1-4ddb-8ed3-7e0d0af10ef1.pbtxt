        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "const CustomForecastTooltip = ({ active, payload, label }: ForecastTooltipProps) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (!active || !payload || !payload.length) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const actualItem = payload.find((p) => p.dataKey === \'actual\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const projectedItem = payload.find((p) => p.dataKey === \'projected\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const optimisticItem = payload.find((p) => p.dataKey === \'optimistic\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const targetItem = payload.find((p) => p.dataKey === \'target\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const previousYearItem = payload.find((p) => p.dataKey === \'previousYear\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const hasActual = actualItem && actualItem.value !== null && actualItem.value !== undefined;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const currentRevenue = hasActual && actualItem.value !== null ? actualItem.value : (projectedItem?.value ?? 0);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const targetVal = targetItem?.value ?? 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const deltaTarget = targetVal > 0 ? currentRevenue - targetVal : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const deltaPercent = targetVal > 0 ? ((deltaTarget / targetVal) * 100).toFixed(1) : \'0.0\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const prevYearVal = previousYearItem?.value ?? 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const yoyDelta = prevYearVal > 0 ? currentRevenue - prevYearVal : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const yoyGrowthPct = prevYearVal > 0 ? ((yoyDelta / prevYearVal) * 100).toFixed(1) : \'0.0\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
