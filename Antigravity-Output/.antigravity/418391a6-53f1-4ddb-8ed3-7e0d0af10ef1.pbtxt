  file_change {
    absolute_path_uri: "file:///src/components/CRMDashboard.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "        {/* Top Highlight KPI Bar */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-10\">\n          <div className=\"p-6 bg-[#F9F8F6] border border-[#1A1A1A]/10 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-[#1A1A1A]/50 mb-4\">\n              <span className=\"text-[10px] uppercase font-bold tracking-widest\">End-to-End Win Rate</span>\n              <Target className=\"w-4 h-4 text-[#23BAA4]\" />\n            </div>\n            <div>\n              <div className=\"text-3xl sm:text-4xl font-black tracking-tight text-[#1A1A1A] flex items-baseline gap-2\">\n                {cumulativeWinRate}%\n                <span className=\"text-xs font-bold text-[#23BAA4] flex items-center\">\n                  <ArrowUpRight className=\"w-3.5 h-3.5\" /> +14.2%\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#1A1A1A]/60 mt-1\">Branchenschnitt liegt bei nur 18%</p>\n            </div>\n          </div>\n\n          <div className=\"p-6 bg-[#F9F8F6] border border-[#1A1A1A]/10 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-[#1A1A1A]/50 mb-4\">\n              <span className=\"text-[10px] uppercase font-bold tracking-widest\">Aktive Pipeline</span>\n              <DollarSign className=\"w-4 h-4 text-[#E56014]\" />\n            </div>\n            <div>\n              <div className=\"text-3xl sm:text-4xl font-black tracking-tight text-[#1A1A1A] flex items-baseline gap-2\">\n                \342\202\254{(totalPipelineValue / 1000).toLocaleString(\'de-DE\', { maximumFractionDigits: 0 })}k\n                <span className=\"text-xs font-bold text-[#23BAA4] flex items-center\">\n                  <ArrowUpRight className=\"w-3.5 h-3.5\" /> +28%\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#1A1A1A]/60 mt-1\">Gewichteter Pipeline-Gesamtwert</p>\n            </div>\n          </div>\n\n          <div className=\"p-6 bg-[#F9F8F6] border border-[#1A1A1A]/10 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-[#1A1A1A]/50 mb-4\">\n              <span className=\"text-[10px] uppercase font-bold tracking-widest\">Prognostizierter ARR</span>\n              <TrendingUp className=\"w-4 h-4 text-[#23BAA4]\" />\n            </div>\n            <div>\n              <div className=\"text-3xl sm:text-4xl font-black tracking-tight text-[#1A1A1A] flex items-baseline gap-2\">\n                \342\202\254{(totalProjectedARR / 1000000).toFixed(2)}M\n                <span className=\"text-xs font-bold text-[#E56014] flex items-center\">\n                  On-Track\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#1A1A1A]/60 mt-1\">Jahres-Umsatzlaufzeit (Run-Rate)</p>\n            </div>\n          </div>\n\n          <div className=\"p-6 bg-[#F9F8F6] border border-[#1A1A1A]/10 flex flex-col justify-between\">\n            <div className=\"flex items-center justify-between text-[#1A1A1A]/50 mb-4\">\n              <span className=\"text-[10px] uppercase font-bold tracking-widest\">Vertriebs-Geschwindigkeit</span>\n              <Zap className=\"w-4 h-4 text-[#E56014]\" />\n            </div>\n            <div>\n              <div className=\"text-3xl sm:text-4xl font-black tracking-tight text-[#1A1A1A] flex items-baseline gap-2\">\n                14.5 T.\n                <span className=\"text-xs font-bold text-[#23BAA4] flex items-center\">\n                  -42% Zeit\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#1A1A1A]/60 mt-1\">Lead bis Abschluss (Vorher: 25 Tage)</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Dynamic View Tab 1: Pipeline Funnel Breakdown */}\n        {activeTab === \'funnel\' && (\n          <motion.div\n            key=\"tab-funnel\"\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.4 }}\n            className=\"grid lg:grid-cols-12 gap-8\"\n          >\n            {/* Funnel Bar Chart */}\n            <div className=\"lg:col-span-8 bg-white border border-[#1A1A1A]/10 p-6 sm:p-8\">\n              <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n                <div>\n                  <h3 className=\"text-xl font-bold tracking-tight text-[#1A1A1A]\">\n                    Stufen-Conversion & Lead-Volumen\n                  </h3>\n                  <p className=\"text-xs text-[#1A1A1A]/60 mt-1\">\n                    Klicken Sie auf eine Phase, um tiefe Detailanalysen und Abwanderungsquoten einzusehen.\n                  </p>\n                </div>\n                <div className=\"text-[11px] font-bold text-[#23BAA4] bg-[#23BAA4]/10 px-3 py-1.5 rounded-full flex items-center gap-1.5\">\n                  <CheckCircle2 className=\"w-3.5 h-3.5\" /> Automatische Lead-\303\234bergabe aktiv\n                </div>\n              </div>\n\n              {/* Recharts Funnel Representation */}\n              <div className=\"h-80 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <BarChart\n                    data={calculatedStages}\n                    margin={{ top: 20, right: 20, left: -10, bottom: 20 }}\n                    onClick={(data: unknown) => {\n                      const chartData = data as { activePayload?: { payload: StageData }[] } | null;\n                      if (chartData?.activePayload && chartData.activePayload.length > 0) {\n                        setSelectedStage(chartData.activePayload[0].payload);\n                      }\n                    }}\n                  >\n                    <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#1A1A1A\" strokeOpacity={0.08} />\n                    <XAxis\n                      dataKey=\"shortName\"\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 12, fontWeight: 600 }}\n                      dy={10}\n                    />\n                    <YAxis\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 11, opacity: 0.6 }}\n                      tickFormatter={(val) => `${val}`}\n                    />\n                    <Tooltip\n                      cursor={{ fill: \'#1A1A1A\', opacity: 0.04 }}\n                      content={({ active, payload }) => {\n                        if (active && payload && payload.length) {\n                          const item = payload[0].payload as StageData;\n                          return (\n                            <div className=\"bg-[#1A1A1A] text-white p-4 text-xs shadow-2xl border border-white/10\">\n                              <p className=\"font-bold text-[#23BAA4] uppercase tracking-wider mb-1\">{item.stage}</p>\n                              <div className=\"space-y-1\">\n                                <p><span className=\"text-white/60\">Anzahl Leads:</span> <strong className=\"text-white\">{item.leads.toLocaleString()}</strong></p>\n                                <p><span className=\"text-white/60\">Stufen-Conversion:</span> <strong className=\"text-[#E56014]\">{item.conversionRate}%</strong></p>\n                                <p><span className=\"text-white/60\">Pipeline-Volumen:</span> <strong className=\"text-white\">\342\202\254{(item.value).toLocaleString()}</strong></p>\n                                <p><span className=\"text-white/60\">Durchschnittliche Verweildauer:</span> <strong className=\"text-white\">{item.avgDays} Tage</strong></p>\n                              </div>\n                            </div>\n                          );\n                        }\n                        return null;\n                      }}\n                    />\n                    <Bar dataKey=\"leads\" radius={[4, 4, 0, 0]} cursor=\"pointer\">\n                      {calculatedStages.map((entry, index) => (\n                        <Cell\n                          key={`cell-${index}`}\n                          fill={selectedStage.id === entry.id ? \'#E56014\' : entry.color}\n                          opacity={selectedStage.id === entry.id ? 1 : 0.85}\n                        />\n                      ))}\n                    </Bar>\n                  </BarChart>\n                </ResponsiveContainer>\n              </div>\n\n              {/* Step Transition Pills */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-2 mt-6 pt-6 border-t border-[#1A1A1A]/10\">\n                {calculatedStages.map((stg) => (\n                  <button\n                    key={stg.id}\n                    onClick={() => setSelectedStage(stg)}\n                    className={`p-3 text-left border transition-all ${\n                      selectedStage.id === stg.id\n                        ? \'border-[#E56014] bg-[#E56014]/5 shadow-sm\'\n                        : \'border-[#1A1A1A]/10 bg-[#F9F8F6] hover:border-[#1A1A1A]/30\'\n                    }`}\n                  >\n                    <div className=\"text-[10px] uppercase font-bold text-[#1A1A1A]/60 tracking-wider truncate\">\n                      {stg.shortName}\n                    </div>\n                    <div className=\"text-lg font-black text-[#1A1A1A] mt-0.5\">\n                      {stg.leads} <span className=\"text-[11px] font-normal text-[#1A1A1A]/50\">Leads</span>\n                    </div>\n                    <div className=\"text-[10px] font-bold text-[#23BAA4] mt-1 flex items-center justify-between\">\n                      <span>Conv: {stg.conversionRate}%</span>\n                    </div>\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            {/* Stage Inspector Sidebar */}\n            <div className=\"lg:col-span-4 flex flex-col gap-6\">\n              <div className=\"bg-[#1A1A1A] text-white p-6 sm:p-8 flex flex-col justify-between flex-1\">\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <span className=\"text-[10px] uppercase tracking-[0.3em] font-bold text-[#23BAA4]\">\n                      Phasen-Inspektor\n                    </span>\n                    <span className=\"text-[11px] px-2.5 py-0.5 rounded-full bg-white/10 font-mono text-white/80\">\n                      {selectedStage.shortName}\n                    </span>\n                  </div>\n                  <h4 className=\"text-2xl font-serif italic text-white mb-2\">\n                    {selectedStage.stage}\n                  </h4>\n                  <p className=\"text-xs text-white/70 leading-relaxed mb-6\">\n                    In dieser Phase sorgt LeadPilot f\303\274r automatisierte Erinnerungen und sofortiges Wiedervorlegen, sobald ein Interessent inaktiv wird.\n                  </p>\n\n                  <div className=\"space-y-4 border-t border-white/10 pt-6\">\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Aktive Interessenten:</span>\n                      <strong className=\"text-white font-mono text-sm\">{selectedStage.leads} Leads</strong>\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Gesamtwert in Phase:</span>\n                      <strong className=\"text-[#E56014] font-mono text-sm\">\342\202\254{selectedStage.value.toLocaleString()}</strong>\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Durchschnittliche Verweildauer:</span>\n                      <strong className=\"text-white font-mono text-sm\">{selectedStage.avgDays} Tage</strong>\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Gefahr von Lead-Dropoff:</span>\n                      <strong className=\"text-emerald-400 font-mono text-sm\">Minimal ({selectedStage.dropOffRate}% durch Auto-Follow-Up)</strong>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"mt-8 pt-6 border-t border-white/10\">\n                  <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/50 mb-3\">\n                    Haupteingangsquellen f\303\274r diese Stufe\n                  </div>\n                  <div className=\"space-y-2\">\n                    {selectedStage.topChannels.map((chn, i) => (\n                      <div key={i} className=\"flex justify-between text-xs items-center bg-white/5 p-2 rounded\">\n                        <span className=\"text-white/80\">{chn.channel}</span>\n                        <span className=\"font-bold text-[#23BAA4]\">{chn.share}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </div>\n          </motion.div>\n        )}\n\n        {/* Dynamic View Tab 2: Monthly Revenue Projections with Interactive Scenario Simulator */}\n        {activeTab === \'forecast\' && (\n          <motion.div\n            key=\"tab-forecast\"\n            initial={{ opacity: 0, y: 15 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ duration: 0.4 }}\n            className=\"grid lg:grid-cols-12 gap-8\"\n          >\n            {/* Forecast Chart */}\n            <div className=\"lg:col-span-8 bg-white border border-[#1A1A1A]/10 p-6 sm:p-8\">\n              <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n                <div>\n                  <h3 className=\"text-xl font-bold tracking-tight text-[#1A1A1A]\">\n                    Monatliche Umsatzprognose & ARR Trajektorie\n                  </h3>\n                  <p className=\"text-xs text-[#1A1A1A]/60 mt-1\">\n                    Vergleich zwischen realisiertem Ist-Umsatz, Modellprognose und Zielen (MRR in \342\202\254).\n                  </p>\n                </div>\n                <div className=\"flex items-center gap-4 text-xs font-bold\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-3 h-3 bg-[#1A1A1A]\"></span> Ist-Umsatz\n                  </div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-3 h-3 bg-[#E56014]\"></span> Prognose\n                  </div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-3 h-3 bg-[#23BAA4]\"></span> Optimistisch\n                  </div>\n                </div>\n              </div>\n\n              {/* Recharts Composed Area & Line Chart */}\n              <div className=\"h-80 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <ComposedChart\n                    data={dynamicProjections}\n                    margin={{ top: 20, right: 20, left: 10, bottom: 20 }}\n                  >\n                    <defs>\n                      <linearGradient id=\"colorProjected\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                        <stop offset=\"5%\" stopColor=\"#E56014\" stopOpacity={0.3} />\n                        <stop offset=\"95%\" stopColor=\"#E56014\" stopOpacity={0.0} />\n                      </linearGradient>\n                      <linearGradient id=\"colorOptimistic\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                        <stop offset=\"5%\" stopColor=\"#23BAA4\" stopOpacity={0.2} />\n                        <stop offset=\"95%\" stopColor=\"#23BAA4\" stopOpacity={0.0} />\n                      </linearGradient>\n                    </defs>\n                    <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#1A1A1A\" strokeOpacity={0.08} />\n                    <XAxis\n                      dataKey=\"month\"\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 12, fontWeight: 600 }}\n                      dy={10}\n                    />\n                    <YAxis\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 11, opacity: 0.6 }}\n                      tickFormatter={(val) => `\342\202\254${val / 1000}k`}\n                    />\n                    <Tooltip\n                      content={({ active, payload, label }) => {\n                        if (active && payload && payload.length) {\n                          return (\n                            <div className=\"bg-[#1A1A1A] text-white p-4 text-xs shadow-2xl border border-white/10 min-w-[200px]\">\n                              <p className=\"font-bold text-[#E56014] uppercase tracking-wider mb-2 border-b border-white/10 pb-1\">\n                                Monat: {label}\n                              </p>\n                              <div className=\"space-y-1.5\">\n                                {payload.map((entry, idx) => (\n                                  <div key={idx} className=\"flex justify-between items-center\">\n                                    <span className=\"text-white/70\">{entry.name}:</span>\n                                    <strong className=\"font-mono text-white\">\n                                      \342\202\254{(entry.value as number)?.toLocaleString(\'de-DE\')}\n                                    </strong>\n                                  </div>\n                                ))}\n                              </div>\n                            </div>\n                          );\n                        }\n                        return null;\n                      }}\n                    />\n                    <Area\n                      type=\"monotone\"\n                      dataKey=\"optimistic\"\n                      name=\"Optimistisches Szenario\"\n                      stroke=\"#23BAA4\"\n                      strokeWidth={2}\n                      strokeDasharray=\"4 4\"\n                      fillOpacity={1}\n                      fill=\"url(#colorOptimistic)\"\n                    />\n                    <Area\n                      type=\"monotone\"\n                      dataKey=\"projected\"\n                      name=\"Erwartete Prognose\"\n                      stroke=\"#E56014\"\n                      strokeWidth={3}\n                      fillOpacity={1}\n                      fill=\"url(#colorProjected)\"\n                    />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"actual\"\n                      name=\"Realisierter Ist-Umsatz\"\n                      stroke=\"#1A1A1A\"\n                      strokeWidth={3}\n                      dot={{ fill: \'#1A1A1A\', r: 5, strokeWidth: 2, stroke: \'#fff\' }}\n                      activeDot={{ r: 7 }}\n                    />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"target\"\n                      name=\"Quartals-Zielvorgabe\"\n                      stroke=\"#9CA3AF\"\n                      strokeWidth={2}\n                      strokeDasharray=\"5 5\"\n                      dot={false}\n                    />\n                  </ComposedChart>\n                </ResponsiveContainer>\n              </div>\n\n              {/* Forecast Insight Summary */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6 pt-6 border-t border-[#1A1A1A]/10 text-xs\">\n                <div className=\"p-4 bg-[#F9F8F6]\">\n                  <span className=\"text-[#1A1A1A]/50 uppercase tracking-wider font-bold block mb-1\">\n                    Zielerreichung (Q3/Q4)\n                  </span>\n                  <span className=\"text-lg font-black text-[#23BAA4]\">+124.6%</span>\n                  <p className=\"text-[11px] text-[#1A1A1A]/60 mt-0.5\">\303\234ber Plan durch konsequentes Follow-Up</p>\n                </div>\n                <div className=\"p-4 bg-[#F9F8F6]\">\n                  <span className=\"text-[#1A1A1A]/50 uppercase tracking-wider font-bold block mb-1\">\n                    Monatlicher Zuwachs\n                  </span>\n                  <span className=\"text-lg font-black text-[#E56014]\">+\342\202\25418.400 / Mo</span>\n                  <p className=\"text-[11px] text-[#1A1A1A]/60 mt-0.5\">Durchschnittliches Wachstumstempo</p>\n                </div>\n                <div className=\"p-4 bg-[#F9F8F6]\">\n                  <span className=\"text-[#1A1A1A]/50 uppercase tracking-wider font-bold block mb-1\">\n                    Gesch\303\244tzter Jahresabschluss\n                  </span>\n                  <span className=\"text-lg font-black text-[#1A1A1A]\">\342\202\2541.48 Mio.</span>\n                  <p className=\"text-[11px] text-[#1A1A1A]/60 mt-0.5\">Gesamtvolumen Neukundengesch\303\244ft</p>\n                </div>\n              </div>\n            </div>\n\n            {/* Interactive Simulation Controls */}\n            <div className=\"lg:col-span-4 bg-[#F9F8F6] border border-[#1A1A1A]/10 p-6 sm:p-8 flex flex-col justify-between\">\n              <div>\n                <div className=\"flex items-center justify-between mb-6 pb-4 border-b border-[#1A1A1A]/10\">\n                  <div className=\"flex items-center gap-2\">\n                    <Sliders className=\"w-4 h-4 text-[#E56014]\" />\n                    <h4 className=\"text-xs uppercase tracking-widest font-bold text-[#1A1A1A]\">\n                      Szenarien-Simulator\n                    </h4>\n                  </div>\n                  <button\n                    onClick={() => {\n                      setLeadBoost(15);\n                      setConvBoost(20);\n                      setDealSizeBoost(10);\n                    }}\n                    className=\"text-[10px] uppercase font-bold tracking-wider text-[#1A1A1A]/50 hover:text-[#E56014] flex items-center gap-1 transition-colors\"\n                  >\n                    <RefreshCw className=\"w-3 h-3\" /> Reset\n                  </button>\n                </div>\n\n                <p className=\"text-xs text-[#1A1A1A]/70 mb-6 leading-relaxed\">\n                  Passen Sie die Hebel an, um sofort die Auswirkungen von LeadPilot-Optimierungen auf Ihren Umsatz zu simulieren:\n                </p>\n\n                {/* Slider 1: Lead Volume */}\n                <div className=\"mb-6\">\n                  <div className=\"flex justify-between text-xs font-bold mb-2\">\n                    <span className=\"text-[#1A1A1A]\">Lead-Volumen Steigerung:</span>\n                    <span className=\"text-[#E56014]\">+{leadBoost}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"50\"\n                    value={leadBoost}\n                    onChange={(e) => setLeadBoost(Number(e.target.value))}\n                    className=\"w-full accent-[#E56014] cursor-pointer h-1.5 bg-[#1A1A1A]/10 rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-[#1A1A1A]/40 mt-1\">\n                    <span>0%</span>\n                    <span>+25%</span>\n                    <span>+50%</span>\n                  </div>\n                </div>\n\n                {/* Slider 2: Conversion Boost */}\n                <div className=\"mb-6\">\n                  <div className=\"flex justify-between text-xs font-bold mb-2\">\n                    <span className=\"text-[#1A1A1A]\">Conversion-Rate Optimierung:</span>\n                    <span className=\"text-[#23BAA4]\">+{convBoost}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"40\"\n                    value={convBoost}\n                    onChange={(e) => setConvBoost(Number(e.target.value))}\n                    className=\"w-full accent-[#23BAA4] cursor-pointer h-1.5 bg-[#1A1A1A]/10 rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-[#1A1A1A]/40 mt-1\">\n                    <span>0% (Status Quo)</span>\n                    <span>+20% (LeadPilot \303\230)</span>\n                    <span>+40%</span>\n                  </div>\n                </div>\n\n                {/* Slider 3: Deal Size */}\n                <div className=\"mb-8\">\n                  <div className=\"flex justify-between text-xs font-bold mb-2\">\n                    <span className=\"text-[#1A1A1A]\">Deal-Gr\303\266\303\237e (Upselling):</span>\n                    <span className=\"text-[#1A1A1A]\">+{dealSizeBoost}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"30\"\n                    value={dealSizeBoost}\n                    onChange={(e) => setDealSizeBoost(Number(e.target.value))}\n                    className=\"w-full accent-[#1A1A1A] cursor-pointer h-1.5 bg-[#1A1A1A]/10 rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-[#1A1A1A]/40 mt-1\">\n                    <span>0%</span>\n                    <span>+15%</span>\n                    <span>+30%</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Simulation Result Card */}\n              <div className=\"p-5 bg-[#1A1A1A] text-white\">\n                <div className=\"flex items-center gap-2 text-[#23BAA4] text-[10px] uppercase font-bold tracking-widest mb-2\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  Kalkulierter Mehrumsatz\n                </div>\n                <div className=\"text-2xl sm:text-3xl font-black tracking-tight text-white mb-1\">\n                  +\342\202\254{Math.round(((totalProjectedARR - 1100000) / 1000)).toLocaleString(\'de-DE\')}k / Jahr\n                </div>\n                <p className=\"text-[11px] text-white/60 leading-normal\">\n                  Zus\303\244tzlicher Ertrag durch strukturierte Wiedervorlage und 0% Lead-Verlust.\n                </p>\n              </div>\n            </div>\n          </motion.div>\n        )}"
      replacement_content: "        {/* Top Highlight KPI Bar */}\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-10\">\n          {[\n            {\n              title: \'End-to-End Win Rate\',\n              icon: Target,\n              iconColor: \'text-[#23BAA4]\',\n              mainValue: `${cumulativeWinRate}%`,\n              badgeText: \'+14.2%\',\n              badgeColor: \'text-[#23BAA4]\',\n              subtext: \'Branchenschnitt liegt bei nur 18%\'\n            },\n            {\n              title: \'Aktive Pipeline\',\n              icon: DollarSign,\n              iconColor: \'text-[#E56014]\',\n              mainValue: `\342\202\254${(totalPipelineValue / 1000).toLocaleString(\'de-DE\', { maximumFractionDigits: 0 })}k`,\n              badgeText: \'+28%\',\n              badgeColor: \'text-[#23BAA4]\',\n              subtext: \'Gewichteter Pipeline-Gesamtwert\'\n            },\n            {\n              title: \'Prognostizierter ARR\',\n              icon: TrendingUp,\n              iconColor: \'text-[#23BAA4]\',\n              mainValue: `\342\202\254${(totalProjectedARR / 1000000).toFixed(2)}M`,\n              badgeText: \'On-Track\',\n              badgeColor: \'text-[#E56014]\',\n              subtext: \'Jahres-Umsatzlaufzeit (Run-Rate)\'\n            },\n            {\n              title: \'Vertriebs-Geschwindigkeit\',\n              icon: Zap,\n              iconColor: \'text-[#E56014]\',\n              mainValue: \'14.5 T.\',\n              badgeText: \'-42% Zeit\',\n              badgeColor: \'text-[#23BAA4]\',\n              subtext: \'Lead bis Abschluss (Vorher: 25 Tage)\'\n            }\n          ].map((kpi, idx) => (\n            <motion.div\n              key={idx}\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: idx * 0.1, ease: \'easeOut\' }}\n              className=\"p-6 bg-[#F9F8F6] border border-[#1A1A1A]/10 flex flex-col justify-between\"\n            >\n              <div className=\"flex items-center justify-between text-[#1A1A1A]/50 mb-4\">\n                <span className=\"text-[10px] uppercase font-bold tracking-widest\">{kpi.title}</span>\n                <kpi.icon className={`w-4 h-4 ${kpi.iconColor}`} />\n              </div>\n              <div>\n                <div className=\"text-3xl sm:text-4xl font-black tracking-tight text-[#1A1A1A] flex items-baseline gap-2\">\n                  {kpi.mainValue}\n                  <span className={`text-xs font-bold ${kpi.badgeColor} flex items-center`}>\n                    <ArrowUpRight className=\"w-3.5 h-3.5\" /> {kpi.badgeText}\n                  </span>\n                </div>\n                <p className=\"text-[11px] text-[#1A1A1A]/60 mt-1\">{kpi.subtext}</p>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n        {/* Dynamic View Tab 1: Pipeline Funnel Breakdown */}\n        {activeTab === \'funnel\' && (\n          <motion.div\n            key={`tab-funnel-${timeRange}`}\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -10 }}\n            transition={{ duration: 0.5, ease: \'easeOut\' }}\n            className=\"grid lg:grid-cols-12 gap-8\"\n          >\n            {/* Funnel Bar Chart */}\n            <motion.div\n              initial={{ opacity: 0, scale: 0.98 }}\n              animate={{ opacity: 1, scale: 1 }}\n              transition={{ duration: 0.6, delay: 0.1, ease: \'easeOut\' }}\n              className=\"lg:col-span-8 bg-white border border-[#1A1A1A]/10 p-6 sm:p-8\"\n            >\n              <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n                <div>\n                  <h3 className=\"text-xl font-bold tracking-tight text-[#1A1A1A]\">\n                    Stufen-Conversion & Lead-Volumen\n                  </h3>\n                  <p className=\"text-xs text-[#1A1A1A]/60 mt-1\">\n                    Klicken Sie auf eine Phase, um tiefe Detailanalysen und Abwanderungsquoten einzusehen.\n                  </p>\n                </div>\n                <div className=\"text-[11px] font-bold text-[#23BAA4] bg-[#23BAA4]/10 px-3 py-1.5 rounded-full flex items-center gap-1.5\">\n                  <CheckCircle2 className=\"w-3.5 h-3.5\" /> Automatische Lead-\303\234bergabe aktiv\n                </div>\n              </div>\n\n              {/* Recharts Funnel Representation with Entrance Animations */}\n              <div className=\"h-80 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <BarChart\n                    key={`barchart-${timeRange}-${leadBoost}-${convBoost}`}\n                    data={calculatedStages}\n                    margin={{ top: 20, right: 20, left: -10, bottom: 20 }}\n                    onClick={(data: unknown) => {\n                      const chartData = data as { activePayload?: { payload: StageData }[] } | null;\n                      if (chartData?.activePayload && chartData.activePayload.length > 0) {\n                        setSelectedStage(chartData.activePayload[0].payload);\n                      }\n                    }}\n                  >\n                    <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#1A1A1A\" strokeOpacity={0.08} />\n                    <XAxis\n                      dataKey=\"shortName\"\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 12, fontWeight: 600 }}\n                      dy={10}\n                    />\n                    <YAxis\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 11, opacity: 0.6 }}\n                      tickFormatter={(val) => `${val}`}\n                    />\n                    <Tooltip\n                      cursor={{ fill: \'#1A1A1A\', opacity: 0.04 }}\n                      content={({ active, payload }) => {\n                        if (active && payload && payload.length) {\n                          const item = payload[0].payload as StageData;\n                          return (\n                            <div className=\"bg-[#1A1A1A] text-white p-4 text-xs shadow-2xl border border-white/10\">\n                              <p className=\"font-bold text-[#23BAA4] uppercase tracking-wider mb-1\">{item.stage}</p>\n                              <div className=\"space-y-1\">\n                                <p><span className=\"text-white/60\">Anzahl Leads:</span> <strong className=\"text-white\">{item.leads.toLocaleString()}</strong></p>\n                                <p><span className=\"text-white/60\">Stufen-Conversion:</span> <strong className=\"text-[#E56014]\">{item.conversionRate}%</strong></p>\n                                <p><span className=\"text-white/60\">Pipeline-Volumen:</span> <strong className=\"text-white\">\342\202\254{(item.value).toLocaleString()}</strong></p>\n                                <p><span className=\"text-white/60\">Durchschnittliche Verweildauer:</span> <strong className=\"text-white\">{item.avgDays} Tage</strong></p>\n                              </div>\n                            </div>\n                          );\n                        }\n                        return null;\n                      }}\n                    />\n                    <Bar\n                      dataKey=\"leads\"\n                      radius={[4, 4, 0, 0]}\n                      cursor=\"pointer\"\n                      isAnimationActive={true}\n                      animationDuration={1300}\n                      animationEasing=\"ease-out\"\n                      animationBegin={200}\n                    >\n                      {calculatedStages.map((entry, index) => (\n                        <Cell\n                          key={`cell-${index}`}\n                          fill={selectedStage.id === entry.id ? \'#E56014\' : entry.color}\n                          opacity={selectedStage.id === entry.id ? 1 : 0.85}\n                        />\n                      ))}\n                    </Bar>\n                  </BarChart>\n                </ResponsiveContainer>\n              </div>\n\n              {/* Step Transition Pills */}\n              <div className=\"grid grid-cols-2 sm:grid-cols-5 gap-2 mt-6 pt-6 border-t border-[#1A1A1A]/10\">\n                {calculatedStages.map((stg) => (\n                  <button\n                    key={stg.id}\n                    onClick={() => setSelectedStage(stg)}\n                    className={`p-3 text-left border transition-all ${\n                      selectedStage.id === stg.id\n                        ? \'border-[#E56014] bg-[#E56014]/5 shadow-sm\'\n                        : \'border-[#1A1A1A]/10 bg-[#F9F8F6] hover:border-[#1A1A1A]/30\'\n                    }`}\n                  >\n                    <div className=\"text-[10px] uppercase font-bold text-[#1A1A1A]/60 tracking-wider truncate\">\n                      {stg.shortName}\n                    </div>\n                    <div className=\"text-lg font-black text-[#1A1A1A] mt-0.5\">\n                      {stg.leads} <span className=\"text-[11px] font-normal text-[#1A1A1A]/50\">Leads</span>\n                    </div>\n                    <div className=\"text-[10px] font-bold text-[#23BAA4] mt-1 flex items-center justify-between\">\n                      <span>Conv: {stg.conversionRate}%</span>\n                    </div>\n                  </button>\n                ))}\n              </div>\n            </motion.div>\n\n            {/* Stage Inspector Sidebar */}\n            <motion.div\n              initial={{ opacity: 0, x: 20 }}\n              animate={{ opacity: 1, x: 0 }}\n              transition={{ duration: 0.6, delay: 0.2, ease: \'easeOut\' }}\n              className=\"lg:col-span-4 flex flex-col gap-6\"\n            >\n              <div className=\"bg-[#1A1A1A] text-white p-6 sm:p-8 flex flex-col justify-between flex-1\">\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <span className=\"text-[10px] uppercase tracking-[0.3em] font-bold text-[#23BAA4]\">\n                      Phasen-Inspektor\n                    </span>\n                    <span className=\"text-[11px] px-2.5 py-0.5 rounded-full bg-white/10 font-mono text-white/80\">\n                      {selectedStage.shortName}\n                    </span>\n                  </div>\n                  <h4 className=\"text-2xl font-serif italic text-white mb-2\">\n                    {selectedStage.stage}\n                  </h4>\n                  <p className=\"text-xs text-white/70 leading-relaxed mb-6\">\n                    In dieser Phase sorgt LeadPilot f\303\274r automatisierte Erinnerungen und sofortiges Wiedervorlegen, sobald ein Interessent inaktiv wird.\n                  </p>\n\n                  <div className=\"space-y-4 border-t border-white/10 pt-6\">\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Aktive Interessenten:</span>\n                      <strong className=\"text-white font-mono text-sm\">{selectedStage.leads} Leads</strong>\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Gesamtwert in Phase:</span>\n                      <strong className=\"text-[#E56014] font-mono text-sm\">\342\202\254{selectedStage.value.toLocaleString()}</strong>\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Durchschnittliche Verweildauer:</span>\n                      <strong className=\"text-white font-mono text-sm\">{selectedStage.avgDays} Tage</strong>\n                    </div>\n                    <div className=\"flex justify-between items-center text-xs\">\n                      <span className=\"text-white/60\">Gefahr von Lead-Dropoff:</span>\n                      <strong className=\"text-emerald-400 font-mono text-sm\">Minimal ({selectedStage.dropOffRate}% durch Auto-Follow-Up)</strong>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"mt-8 pt-6 border-t border-white/10\">\n                  <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/50 mb-3\">\n                    Haupteingangsquellen f\303\274r diese Stufe\n                  </div>\n                  <div className=\"space-y-2\">\n                    {selectedStage.topChannels.map((chn, i) => (\n                      <div key={i} className=\"flex justify-between text-xs items-center bg-white/5 p-2 rounded\">\n                        <span className=\"text-white/80\">{chn.channel}</span>\n                        <span className=\"font-bold text-[#23BAA4]\">{chn.share}</span>\n                      </div>\n                    ))}\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          </motion.div>\n        )}\n\n        {/* Dynamic View Tab 2: Monthly Revenue Projections with Interactive Scenario Simulator */}\n        {activeTab === \'forecast\' && (\n          <motion.div\n            key={`tab-forecast-${timeRange}`}\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -10 }}\n            transition={{ duration: 0.5, ease: \'easeOut\' }}\n            className=\"grid lg:grid-cols-12 gap-8\"\n          >\n            {/* Forecast Chart */}\n            <motion.div\n              initial={{ opacity: 0, scale: 0.98 }}\n              animate={{ opacity: 1, scale: 1 }}\n              transition={{ duration: 0.6, delay: 0.1, ease: \'easeOut\' }}\n              className=\"lg:col-span-8 bg-white border border-[#1A1A1A]/10 p-6 sm:p-8\"\n            >\n              <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center mb-8 gap-4\">\n                <div>\n                  <h3 className=\"text-xl font-bold tracking-tight text-[#1A1A1A]\">\n                    Monatliche Umsatzprognose & ARR Trajektorie\n                  </h3>\n                  <p className=\"text-xs text-[#1A1A1A]/60 mt-1\">\n                    Vergleich zwischen realisiertem Ist-Umsatz, Modellprognose und Zielen (MRR in \342\202\254).\n                  </p>\n                </div>\n                <div className=\"flex items-center gap-4 text-xs font-bold\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-3 h-3 bg-[#1A1A1A]\"></span> Ist-Umsatz\n                  </div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-3 h-3 bg-[#E56014]\"></span> Prognose\n                  </div>\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"w-3 h-3 bg-[#23BAA4]\"></span> Optimistisch\n                  </div>\n                </div>\n              </div>\n\n              {/* Recharts Composed Area & Line Chart with Entrance Animations */}\n              <div className=\"h-80 w-full\">\n                <ResponsiveContainer width=\"100%\" height=\"100%\">\n                  <ComposedChart\n                    key={`composedchart-${timeRange}-${leadBoost}-${convBoost}-${dealSizeBoost}`}\n                    data={dynamicProjections}\n                    margin={{ top: 20, right: 20, left: 10, bottom: 20 }}\n                  >\n                    <defs>\n                      <linearGradient id=\"colorProjected\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                        <stop offset=\"5%\" stopColor=\"#E56014\" stopOpacity={0.3} />\n                        <stop offset=\"95%\" stopColor=\"#E56014\" stopOpacity={0.0} />\n                      </linearGradient>\n                      <linearGradient id=\"colorOptimistic\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                        <stop offset=\"5%\" stopColor=\"#23BAA4\" stopOpacity={0.2} />\n                        <stop offset=\"95%\" stopColor=\"#23BAA4\" stopOpacity={0.0} />\n                      </linearGradient>\n                    </defs>\n                    <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#1A1A1A\" strokeOpacity={0.08} />\n                    <XAxis\n                      dataKey=\"month\"\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 12, fontWeight: 600 }}\n                      dy={10}\n                    />\n                    <YAxis\n                      axisLine={false}\n                      tickLine={false}\n                      tick={{ fill: \'#1A1A1A\', fontSize: 11, opacity: 0.6 }}\n                      tickFormatter={(val) => `\342\202\254${val / 1000}k`}\n                    />\n                    <Tooltip\n                      content={({ active, payload, label }) => {\n                        if (active && payload && payload.length) {\n                          return (\n                            <div className=\"bg-[#1A1A1A] text-white p-4 text-xs shadow-2xl border border-white/10 min-w-[200px]\">\n                              <p className=\"font-bold text-[#E56014] uppercase tracking-wider mb-2 border-b border-white/10 pb-1\">\n                                Monat: {label}\n                              </p>\n                              <div className=\"space-y-1.5\">\n                                {payload.map((entry, idx) => (\n                                  <div key={idx} className=\"flex justify-between items-center\">\n                                    <span className=\"text-white/70\">{entry.name}:</span>\n                                    <strong className=\"font-mono text-white\">\n                                      \342\202\254{(entry.value as number)?.toLocaleString(\'de-DE\')}\n                                    </strong>\n                                  </div>\n                                ))}\n                              </div>\n                            </div>\n                          );\n                        }\n                        return null;\n                      }}\n                    />\n                    <Area\n                      type=\"monotone\"\n                      dataKey=\"optimistic\"\n                      name=\"Optimistisches Szenario\"\n                      stroke=\"#23BAA4\"\n                      strokeWidth={2}\n                      strokeDasharray=\"4 4\"\n                      fillOpacity={1}\n                      fill=\"url(#colorOptimistic)\"\n                      isAnimationActive={true}\n                      animationDuration={1500}\n                      animationEasing=\"ease-out\"\n                      animationBegin={150}\n                    />\n                    <Area\n                      type=\"monotone\"\n                      dataKey=\"projected\"\n                      name=\"Erwartete Prognose\"\n                      stroke=\"#E56014\"\n                      strokeWidth={3}\n                      fillOpacity={1}\n                      fill=\"url(#colorProjected)\"\n                      isAnimationActive={true}\n                      animationDuration={1800}\n                      animationEasing=\"ease-out\"\n                      animationBegin={250}\n                    />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"actual\"\n                      name=\"Realisierter Ist-Umsatz\"\n                      stroke=\"#1A1A1A\"\n                      strokeWidth={3}\n                      dot={{ fill: \'#1A1A1A\', r: 5, strokeWidth: 2, stroke: \'#fff\' }}\n                      activeDot={{ r: 7 }}\n                      isAnimationActive={true}\n                      animationDuration={2000}\n                      animationEasing=\"ease-out\"\n                      animationBegin={400}\n                    />\n                    <Line\n                      type=\"monotone\"\n                      dataKey=\"target\"\n                      name=\"Quartals-Zielvorgabe\"\n                      stroke=\"#9CA3AF\"\n                      strokeWidth={2}\n                      strokeDasharray=\"5 5\"\n                      dot={false}\n                      isAnimationActive={true}\n                      animationDuration={1600}\n                      animationEasing=\"ease-out\"\n                      animationBegin={200}\n                    />\n                  </ComposedChart>\n                </ResponsiveContainer>\n              </div>\n\n              {/* Forecast Insight Summary */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mt-6 pt-6 border-t border-[#1A1A1A]/10 text-xs\">\n                <div className=\"p-4 bg-[#F9F8F6]\">\n                  <span className=\"text-[#1A1A1A]/50 uppercase tracking-wider font-bold block mb-1\">\n                    Zielerreichung (Q3/Q4)\n                  </span>\n                  <span className=\"text-lg font-black text-[#23BAA4]\">+124.6%</span>\n                  <p className=\"text-[11px] text-[#1A1A1A]/60 mt-0.5\">\303\234ber Plan durch konsequentes Follow-Up</p>\n                </div>\n                <div className=\"p-4 bg-[#F9F8F6]\">\n                  <span className=\"text-[#1A1A1A]/50 uppercase tracking-wider font-bold block mb-1\">\n                    Monatlicher Zuwachs\n                  </span>\n                  <span className=\"text-lg font-black text-[#E56014]\">+\342\202\25418.400 / Mo</span>\n                  <p className=\"text-[11px] text-[#1A1A1A]/60 mt-0.5\">Durchschnittliches Wachstumstempo</p>\n                </div>\n                <div className=\"p-4 bg-[#F9F8F6]\">\n                  <span className=\"text-[#1A1A1A]/50 uppercase tracking-wider font-bold block mb-1\">\n                    Gesch\303\244tzter Jahresabschluss\n                  </span>\n                  <span className=\"text-lg font-black text-[#1A1A1A]\">\342\202\2541.48 Mio.</span>\n                  <p className=\"text-[11px] text-[#1A1A1A]/60 mt-0.5\">Gesamtvolumen Neukundengesch\303\244ft</p>\n                </div>\n              </div>\n            </motion.div>\n\n            {/* Interactive Simulation Controls */}\n            <motion.div\n              initial={{ opacity: 0, x: 20 }}\n              animate={{ opacity: 1, x: 0 }}\n              transition={{ duration: 0.6, delay: 0.2, ease: \'easeOut\' }}\n              className=\"lg:col-span-4 bg-[#F9F8F6] border border-[#1A1A1A]/10 p-6 sm:p-8 flex flex-col justify-between\"\n            >\n              <div>\n                <div className=\"flex items-center justify-between mb-6 pb-4 border-b border-[#1A1A1A]/10\">\n                  <div className=\"flex items-center gap-2\">\n                    <Sliders className=\"w-4 h-4 text-[#E56014]\" />\n                    <h4 className=\"text-xs uppercase tracking-widest font-bold text-[#1A1A1A]\">\n                      Szenarien-Simulator\n                    </h4>\n                  </div>\n                  <button\n                    onClick={() => {\n                      setLeadBoost(15);\n                      setConvBoost(20);\n                      setDealSizeBoost(10);\n                    }}\n                    className=\"text-[10px] uppercase font-bold tracking-wider text-[#1A1A1A]/50 hover:text-[#E56014] flex items-center gap-1 transition-colors\"\n                  >\n                    <RefreshCw className=\"w-3 h-3\" /> Reset\n                  </button>\n                </div>\n\n                <p className=\"text-xs text-[#1A1A1A]/70 mb-6 leading-relaxed\">\n                  Passen Sie die Hebel an, um sofort die Auswirkungen von LeadPilot-Optimierungen auf Ihren Umsatz zu simulieren:\n                </p>\n\n                {/* Slider 1: Lead Volume */}\n                <div className=\"mb-6\">\n                  <div className=\"flex justify-between text-xs font-bold mb-2\">\n                    <span className=\"text-[#1A1A1A]\">Lead-Volumen Steigerung:</span>\n                    <span className=\"text-[#E56014]\">+{leadBoost}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"50\"\n                    value={leadBoost}\n                    onChange={(e) => setLeadBoost(Number(e.target.value))}\n                    className=\"w-full accent-[#E56014] cursor-pointer h-1.5 bg-[#1A1A1A]/10 rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-[#1A1A1A]/40 mt-1\">\n                    <span>0%</span>\n                    <span>+25%</span>\n                    <span>+50%</span>\n                  </div>\n                </div>\n\n                {/* Slider 2: Conversion Boost */}\n                <div className=\"mb-6\">\n                  <div className=\"flex justify-between text-xs font-bold mb-2\">\n                    <span className=\"text-[#1A1A1A]\">Conversion-Rate Optimierung:</span>\n                    <span className=\"text-[#23BAA4]\">+{convBoost}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"40\"\n                    value={convBoost}\n                    onChange={(e) => setConvBoost(Number(e.target.value))}\n                    className=\"w-full accent-[#23BAA4] cursor-pointer h-1.5 bg-[#1A1A1A]/10 rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-[#1A1A1A]/40 mt-1\">\n                    <span>0% (Status Quo)</span>\n                    <span>+20% (LeadPilot \303\230)</span>\n                    <span>+40%</span>\n                  </div>\n                </div>\n\n                {/* Slider 3: Deal Size */}\n                <div className=\"mb-8\">\n                  <div className=\"flex justify-between text-xs font-bold mb-2\">\n                    <span className=\"text-[#1A1A1A]\">Deal-Gr\303\266\303\237e (Upselling):</span>\n                    <span className=\"text-[#1A1A1A]\">+{dealSizeBoost}%</span>\n                  </div>\n                  <input\n                    type=\"range\"\n                    min=\"0\"\n                    max=\"30\"\n                    value={dealSizeBoost}\n                    onChange={(e) => setDealSizeBoost(Number(e.target.value))}\n                    className=\"w-full accent-[#1A1A1A] cursor-pointer h-1.5 bg-[#1A1A1A]/10 rounded-lg\"\n                  />\n                  <div className=\"flex justify-between text-[10px] text-[#1A1A1A]/40 mt-1\">\n                    <span>0%</span>\n                    <span>+15%</span>\n                    <span>+30%</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Simulation Result Card */}\n              <div className=\"p-5 bg-[#1A1A1A] text-white\">\n                <div className=\"flex items-center gap-2 text-[#23BAA4] text-[10px] uppercase font-bold tracking-widest mb-2\">\n                  <Sparkles className=\"w-3.5 h-3.5\" />\n                  Kalkulierter Mehrumsatz\n                </div>\n                <div className=\"text-2xl sm:text-3xl font-black tracking-tight text-white mb-1\">\n                  +\342\202\254{Math.round(((totalProjectedARR - 1100000) / 1000)).toLocaleString(\'de-DE\')}k / Jahr\n                </div>\n                <p className=\"text-[11px] text-white/60 leading-normal\">\n                  Zus\303\244tzlicher Ertrag durch strukturierte Wiedervorlage und 0% Lead-Verlust.\n                </p>\n              </div>\n            </motion.div>\n          </motion.div>\n        )}"
    }
