    replacement_chunks {
      target_content: "import { motion } from \'motion/react\';\nimport { ArrowRight } from \'lucide-react\';\n\nexport function CaseStudy() {\n  return (\n    <section className=\"py-32 bg-[#1A1A1A] text-white border-b border-[#1A1A1A]/10\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-10\">\n        <div className=\"grid md:grid-cols-12 gap-16 items-start\">\n          <div className=\"md:col-span-6\">\n            <motion.div\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5 }}\n            >\n              <h2 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-white/50\">Success Story</h2>\n              <h3 className=\"text-[40px] md:text-[60px] leading-[0.9] font-black uppercase tracking-tighter mb-8\">\n                Wachstum durch <span className=\"font-serif italic font-normal tracking-normal text-white/60\">Struktur.</span>\n              </h3>\n              \n              <div className=\"pt-10 border-t border-white/10 mt-12 grid grid-cols-2 gap-8\">\n                <div>\n                   <div className=\"text-[48px] font-serif italic leading-none mb-2\">+22%</div>\n                   <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/40\">Win-Rate</div>\n                </div>\n                <div>\n                   <div className=\"text-[48px] font-serif italic leading-none mb-2\">-85%</div>\n                   <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/40\">Reaktionszeit</div>\n                </div>\n              </div>\n            </motion.div>\n          </div>\n          \n          <div className=\"md:col-span-6 md:pl-10 md:border-l border-white/10 h-full flex flex-col justify-center\">\n            <motion.div\n              initial={{ opacity: 0, y: 20 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5, delay: 0.2 }}\n            >\n              <div className=\"text-[80px] font-serif italic leading-none text-white/20 mb-4 h-10\">\"</div>\n              <p className=\"text-xl md:text-2xl leading-relaxed text-white/90 mb-10 font-serif italic\">\n                Bevor wir LeadPilot nutzten, war unser Sales-Prozess stark von einzelnen Mitarbeitern abh\303\244ngig. Fiel jemand aus, blieben Leads in der Excel-Tabelle liegen. Heute wird jeder Kontakt automatisch zugewiesen \342\200\223 wir verlieren keine wertvollen Opportunities mehr.\n              </p>\n              \n              <div className=\"mb-12\">\n                <p className=\"text-sm font-bold uppercase tracking-widest text-white\">Thomas Weber</p>\n                <p className=\"text-xs uppercase tracking-widest text-white/50 mt-2\">Head of Sales, Maschinenbau M\303\274ller GmbH</p>\n              </div>\n\n              <button className=\"group inline-flex items-center gap-3 text-xs uppercase tracking-widest font-bold text-white hover:text-white/70 transition-colors\">\n                <span className=\"border-b border-white pb-1\">Ganze Story lesen</span>\n                <ArrowRight className=\"h-4 w-4 transition-transform group-hover:translate-x-2\" />\n              </button>\n            </motion.div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}"
      replacement_content: "import { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { ArrowRight, X } from \'lucide-react\';\n\nexport function CaseStudy() {\n  const [isModalOpen, setIsModalOpen] = useState(false);\n\n  return (\n    <>\n      <section className=\"py-32 bg-[#1A1A1A] text-white border-b border-[#1A1A1A]/10\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-10\">\n          <div className=\"grid md:grid-cols-12 gap-16 items-start\">\n            <div className=\"md:col-span-6\">\n              <motion.div\n                initial={{ opacity: 0, y: 20 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.5 }}\n              >\n                <h2 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-white/50\">Success Story</h2>\n                <h3 className=\"text-[40px] md:text-[60px] leading-[0.9] font-black uppercase tracking-tighter mb-8\">\n                  Wachstum durch <span className=\"font-serif italic font-normal tracking-normal text-white/60\">Struktur.</span>\n                </h3>\n                \n                <div className=\"pt-10 border-t border-white/10 mt-12 grid grid-cols-2 gap-8\">\n                  <div>\n                     <div className=\"text-[48px] font-serif italic leading-none mb-2\">+22%</div>\n                     <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/40\">Win-Rate</div>\n                  </div>\n                  <div>\n                     <div className=\"text-[48px] font-serif italic leading-none mb-2\">-85%</div>\n                     <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/40\">Reaktionszeit</div>\n                  </div>\n                </div>\n              </motion.div>\n            </div>\n            \n            <div className=\"md:col-span-6 md:pl-10 md:border-l border-white/10 h-full flex flex-col justify-center\">\n              <motion.div\n                initial={{ opacity: 0, y: 20 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.5, delay: 0.2 }}\n              >\n                <div className=\"text-[80px] font-serif italic leading-none text-white/20 mb-4 h-10\">\"</div>\n                <p className=\"text-xl md:text-2xl leading-relaxed text-white/90 mb-10 font-serif italic\">\n                  Bevor wir LeadPilot nutzten, war unser Sales-Prozess stark von einzelnen Mitarbeitern abh\303\244ngig. Fiel jemand aus, blieben Leads in der Excel-Tabelle liegen. Heute wird jeder Kontakt automatisch zugewiesen \342\200\223 wir verlieren keine wertvollen Opportunities mehr.\n                </p>\n                \n                <div className=\"mb-12\">\n                  <p className=\"text-sm font-bold uppercase tracking-widest text-white\">Thomas Weber</p>\n                  <p className=\"text-xs uppercase tracking-widest text-white/50 mt-2\">Head of Sales, Maschinenbau M\303\274ller GmbH</p>\n                </div>\n\n                <button \n                  onClick={() => setIsModalOpen(true)}\n                  className=\"group inline-flex items-center gap-3 text-xs uppercase tracking-widest font-bold text-white hover:text-white/70 transition-colors\"\n                >\n                  <span className=\"border-b border-white pb-1\">Ganze Story lesen</span>\n                  <ArrowRight className=\"h-4 w-4 transition-transform group-hover:translate-x-2\" />\n                </button>\n              </motion.div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <AnimatePresence>\n        {isModalOpen && (\n          <motion.div\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"fixed inset-0 z-[100] flex items-center justify-center bg-[#1A1A1A]/90 backdrop-blur-sm p-4 sm:p-6 lg:p-10\"\n          >\n            <motion.div\n              initial={{ opacity: 0, y: 50, scale: 0.95 }}\n              animate={{ opacity: 1, y: 0, scale: 1 }}\n              exit={{ opacity: 0, y: 20, scale: 0.95 }}\n              transition={{ type: \"spring\", damping: 25, stiffness: 300 }}\n              className=\"bg-[#F9F8F6] text-[#1A1A1A] w-full max-w-4xl max-h-[90vh] overflow-y-auto border-8 border-white shadow-2xl relative\"\n            >\n              <button \n                onClick={() => setIsModalOpen(false)}\n                className=\"absolute top-6 right-6 p-2 bg-[#1A1A1A] text-white hover:bg-[#333] transition-colors z-10\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n\n              <div className=\"p-10 md:p-16\">\n                <div className=\"mb-16 border-b border-[#1A1A1A]/10 pb-16\">\n                  <span className=\"text-[10px] uppercase tracking-[0.4em] mb-6 font-semibold text-[#1A1A1A]/50 block\">Case Study: Maschinenbau M\303\274ller GmbH</span>\n                  <h2 className=\"text-[40px] md:text-[60px] leading-[0.9] font-black uppercase tracking-tighter mb-8\">\n                    Vom <span className=\"font-serif italic font-normal tracking-normal text-[#1A1A1A]/40\">Zettel-Chaos</span><br />zur digitalen Sales-Maschine.\n                  </h2>\n                  <div className=\"flex flex-wrap gap-8 text-[10px] uppercase tracking-widest font-bold\">\n                    <div>\n                      <span className=\"text-[#1A1A1A]/40 block mb-1\">Branche</span>\n                      <span>Sondermaschinenbau</span>\n                    </div>\n                    <div>\n                      <span className=\"text-[#1A1A1A]/40 block mb-1\">Mitarbeiter</span>\n                      <span>150+</span>\n                    </div>\n                    <div>\n                      <span className=\"text-[#1A1A1A]/40 block mb-1\">Sales-Team</span>\n                      <span>12 Personen</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"prose prose-slate max-w-none\">\n                  <div className=\"grid md:grid-cols-12 gap-12\">\n                    <div className=\"md:col-span-8 space-y-8 text-sm leading-relaxed text-[#1A1A1A]/80\">\n                      <p>\n                        <span className=\"float-left text-[60px] leading-[50px] font-serif italic text-[#1A1A1A] mr-4 mt-2\">D</span>\n                        ie Maschinenbau M\303\274ller GmbH geh\303\266rt zu den Hidden Champions der Region. \303\234ber Jahrzehnte wuchs das Unternehmen organisch, vor allem durch Empfehlungen. Doch mit der Expansion in neue M\303\244rkte wuchsen auch die Herausforderungen im Vertrieb.\n                      </p>\n                      \n                      <h4 className=\"text-xs uppercase tracking-widest font-bold text-[#1A1A1A] mt-12 mb-4\">Die Ausgangslage: Wer ist zust\303\244ndig?</h4>\n                      <p>\n                        \"Unsere Leads kamen \303\274ber Messen, die Website und Telefonanrufe rein\", erinnert sich Thomas Weber, Head of Sales. \"Wir haben sie in eine gro\303\237e Excel-Liste eingetragen. Jeder Vertriebler sollte sich theoretisch selbst bedienen.\" In der Praxis f\303\274hrte dies zum bekannten <em>Bystander-Effekt</em>: Wenn alle zust\303\244ndig sind, ist es letztlich niemand.\n                      </p>\n                      <p>\n                        Die Folgen waren sp\303\274rbar: Die durchschnittliche Reaktionszeit auf eine Web-Anfrage lag bei fast 4 Tagen. In einer Branche, in der es um Projekte im sechsstelligen Bereich geht, ein fataler Wettbewerbsnachteil. Oft hatten Wettbewerber bereits den ersten Vor-Ort-Termin vereinbart, bevor sich bei M\303\274ller \303\274berhaupt jemand meldete.\n                      </p>\n\n                      <h4 className=\"text-xs uppercase tracking-widest font-bold text-[#1A1A1A] mt-12 mb-4\">Der Wendepunkt: LeadPilot</h4>\n                      <p>\n                        Die Suche nach einem CRM gestaltete sich anfangs schwierig. Die gro\303\237en L\303\266sungen am Markt waren f\303\274r das 12-k\303\266pfige Sales-Team v\303\266llig \303\274berdimensioniert. \"Wir brauchten kein System, f\303\274r das ich einen eigenen IT-Administrator einstellen muss. Wir brauchten Struktur\", so Weber.\n                      </p>\n                      <p>\n                        Mit LeadPilot \303\244nderte sich der Prozess fundamental. Statt einer passiven Liste gibt es nun aktive Zuweisungen. Ein neuer Lead wird anhand von Postleitzahl und Branche automatisch dem richtigen Mitarbeiter zugeordnet. \n                      </p>\n                      \n                      <div className=\"my-10 p-8 bg-white border border-[#1A1A1A]/10 border-l-4 border-l-[#1A1A1A]\">\n                        <p className=\"font-serif italic text-lg m-0\">\"Das Beste an LeadPilot ist nicht, was man damit alles machen kann. Das Beste ist, was man nicht mehr machen muss. Das System nimmt uns das Denken an den Prozess ab, sodass wir uns auf den Kunden konzentrieren k\303\266nnen.\"</p>\n                      </div>\n\n                      <h4 className=\"text-xs uppercase tracking-widest font-bold text-[#1A1A1A] mt-12 mb-4\">Die Resultate</h4>\n                      <p>\n                        Heute wird jeder neue Kontakt innerhalb von durchschnittlich 14 Stunden angerufen \342\200\223 eine Reduktion der Reaktionszeit um 85%. Noch wichtiger: Durch die automatischen Wiedervorlagen nach dem Erstgespr\303\244ch bleibt das Team konsequent am Ball.\n                      </p>\n                      <p>\n                        Die Win-Rate bei Neukunden stieg innerhalb der ersten 6 Monate um 22%. \"Nicht, weil wir pl\303\266tzlich besser verkaufen k\303\266nnen\", analysiert Weber, \"sondern weil wir schlichtweg \303\266fter zum richtigen Zeitpunkt nachfassen und keine Opportunities mehr versanden lassen.\"\n                      </p>\n                    </div>\n\n                    <div className=\"md:col-span-4\">\n                      <div className=\"sticky top-10\">\n                        <div className=\"bg-[#1A1A1A] text-white p-8 mb-8\">\n                          <h5 className=\"text-[10px] uppercase tracking-widest font-bold text-white/50 mb-6\">Key Results</h5>\n                          <ul className=\"space-y-6\">\n                            <li>\n                              <div className=\"text-2xl font-serif italic mb-1\">-85%</div>\n                              <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/70\">Reaktionszeit (Time-to-Contact)</div>\n                            </li>\n                            <li className=\"border-t border-white/10 pt-6\">\n                              <div className=\"text-2xl font-serif italic mb-1\">+22%</div>\n                              <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/70\">Steigerung der Win-Rate</div>\n                            </li>\n                            <li className=\"border-t border-white/10 pt-6\">\n                              <div className=\"text-2xl font-serif italic mb-1\">100%</div>\n                              <div className=\"text-[10px] uppercase tracking-widest font-bold text-white/70\">Transparenz im Sales-Funnel</div>\n                            </li>\n                          </ul>\n                        </div>\n                        \n                        <button onClick={() => setIsModalOpen(false)} className=\"w-full text-center border border-[#1A1A1A] text-[#1A1A1A] hover:bg-[#1A1A1A] hover:text-white transition-colors py-4 text-xs uppercase tracking-widest font-bold\">\n                          Schlie\303\237en\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </>\n  );\n}"
    }
