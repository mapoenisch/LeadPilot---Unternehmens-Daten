      replacement_content: "import { BrainCircuit, ListChecks, LineChart, ShieldCheck } from \'lucide-react\';\nimport { motion } from \'motion/react\';\n\nconst features = [\n  {\n    icon: ListChecks,\n    title: \'Automatische Lead-Zuweisung\',\n    description: \'Nach jedem Kontakt legt das System automatisch die n\303\244chste f\303\244llige Aktivit\303\244t an. Nie wieder Excel-Tabellen pflegen.\'\n  },\n  {\n    icon: BrainCircuit,\n    title: \'KI-gest\303\274tztes Scoring\',\n    description: \'Unsere Engine priorisiert Ihre Leads nach Abschlusswahrscheinlichkeit, damit Sie Ihre Zeit in die richtigen Kunden investieren.\'\n  },\n  {\n    icon: LineChart,\n    title: \'Echtzeit-Pipeline\',\n    description: \'Ein klares Dashboard zeigt dem Vertriebsleiter sofort, welche Leads \303\274berf\303\244llig sind und wie sich die Ums\303\244tze entwickeln.\'\n  },\n  {\n    icon: ShieldCheck,\n    title: \'Made f\303\274r den Mittelstand\',\n    description: \'Einfacher als Salesforce oder HubSpot. Innerhalb weniger Tage eingef\303\274hrt und zu 100% DSGVO-konform (Hosting in Europa).\'\n  }\n];\n\nexport function Features() {\n  return (\n    <section id=\"funktionen\" className=\"py-24 bg-slate-50\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center max-w-3xl mx-auto mb-16\">\n          <h2 className=\"text-3xl md:text-4xl font-bold text-slate-900 mb-4\">\n            Alles, was Sie f\303\274r strukturierten Vertrieb brauchen\n          </h2>\n          <p className=\"text-lg text-slate-600\">\n            Wir haben LeadPilot bewusst schlank gehalten. Keine \303\274berladenen Men\303\274s, keine unn\303\266tigen Marketing-Features \342\200\223 reiner Fokus auf Ihren Sales-Erfolg.\n          </p>\n        </div>\n\n        <div className=\"grid md:grid-cols-2 gap-8\">\n          {features.map((feature, index) => {\n            const Icon = feature.icon;\n            return (\n              <motion.div\n                key={index}\n                className=\"bg-white p-8 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow\"\n                initial={{ opacity: 0, y: 20 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true }}\n                transition={{ duration: 0.4, delay: index * 0.1 }}\n              >\n                <div className=\"bg-teal-50 w-12 h-12 rounded-xl flex items-center justify-center mb-6\">\n                  <Icon className=\"h-6 w-6 text-teal-600\" />\n                </div>\n                <h3 className=\"text-xl font-bold text-slate-900 mb-3\">{feature.title}</h3>\n                <p className=\"text-slate-600 leading-relaxed\">\n                  {feature.description}\n                </p>\n              </motion.div>\n            );\n          })}\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
