        }
        lines {
          text: "  "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Lead Sources Breakdown Modal State"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
