      target_content: "    <section id=\"problem\" className=\"py-24 bg-white\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"grid md:grid-cols-2 gap-16 items-center\">\n          <div>\n            <motion.div\n              initial={{ opacity: 0, x: -20 }}\n              whileInView={{ opacity: 1, x: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5 }}\n            >\n              <h2 className=\"text-3xl md:text-4xl font-bold text-slate-900 mb-6\">\n                Warum bis zu <span className=\"text-orange-500\">70% aller Leads</span> nie kontaktiert werden\n              </h2>\n              <p className=\"text-lg text-slate-600 mb-8 leading-relaxed\">\n                Ein Interessent f\303\274llt das Kontaktformular aus. Zwei Tage sp\303\244ter hat noch niemand angerufen. Eine Woche sp\303\244ter ist der Kontakt im Postfach untergegangen. Kommt Ihnen das bekannt vor?\n              </p>\n              \n              <div className=\"space-y-6\">\n                <div className=\"flex gap-4\">\n                  <div className=\"bg-orange-50 p-3 rounded-lg h-fit\">\n                    <AlertTriangle className=\"h-6 w-6 text-orange-500\" />\n                  </div>\n                  <div>\n                    <h3 className=\"font-semibold text-slate-900 mb-1\">Zettelwirtschaft & Excel-Chaos</h3>\n                    <p className=\"text-slate-600\">Leads landen in verstreuten Listen, die eigentlich nur eine Person wirklich pflegt. F\303\244llt diese aus, steht der Vertrieb still.</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-4\">\n                  <div className=\"bg-orange-50 p-3 rounded-lg h-fit\">\n                    <Users className=\"h-6 w-6 text-orange-500\" />\n                  </div>\n                  <div>\n                    <h3 className=\"font-semibold text-slate-900 mb-1\">Unklare Verantwortlichkeiten</h3>\n                    <p className=\"text-slate-600\">Wenn ein Lead theoretisch \"dem ganzen Team\" geh\303\266rt, f\303\274hlt sich in der Praxis niemand wirklich zust\303\244ndig.</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-4\">\n                  <div className=\"bg-orange-50 p-3 rounded-lg h-fit\">\n                    <Clock className=\"h-6 w-6 text-orange-500\" />\n                  </div>\n                  <div>\n                    <h3 className=\"font-semibold text-slate-900 mb-1\">Fehlender Prozess</h3>\n                    <p className=\"text-slate-600\">Nach einem Anruf bleibt es bei einem vagen \"ich melde mich n\303\244chste Woche\". Ohne System geht genau das im Tagesgesch\303\244ft unter.</p>\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          </div>\n          \n          <div className=\"relative\">\n            <motion.div\n              className=\"bg-slate-50 border border-slate-200 rounded-2xl p-8 shadow-sm\"\n              initial={{ opacity: 0, x: 20 }}\n              whileInView={{ opacity: 1, x: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5 }}\n            >\n              <div className=\"mb-6 pb-6 border-b border-slate-200\">\n                <h3 className=\"font-semibold text-lg text-slate-900\">Die L\303\266sung von LeadPilot</h3>\n                <p className=\"text-slate-600 mt-2\">Ein klares System statt Vorw\303\274rfen an das Team.</p>\n              </div>\n              \n              <ul className=\"space-y-4\">\n                <li className=\"flex items-start gap-3\">\n                  <CheckCircle2 className=\"h-5 w-5 text-teal-600 shrink-0 mt-0.5\" />\n                  <span className=\"text-slate-700\"><strong>Jeder Lead</strong> bekommt einen klaren n\303\244chsten Schritt</span>\n                </li>\n                <li className=\"flex items-start gap-3\">\n                  <CheckCircle2 className=\"h-5 w-5 text-teal-600 shrink-0 mt-0.5\" />\n                  <span className=\"text-slate-700\"><strong>Klare Zuweisung</strong> an einen spezifischen Mitarbeiter</span>\n                </li>\n                <li className=\"flex items-start gap-3\">\n                  <CheckCircle2 className=\"h-5 w-5 text-teal-600 shrink-0 mt-0.5\" />\n                  <span className=\"text-slate-700\"><strong>Automatische Erinnerungen</strong>, bevor ein Lead abk\303\274hlt</span>\n                </li>\n              </ul>\n            </motion.div>\n          </div>\n        </div>\n      </div>\n    </section>"
      replacement_content: "    <section id=\"problem\" className=\"py-32 bg-white border-b border-[#1A1A1A]/10\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-10\">\n        <div className=\"grid md:grid-cols-12 gap-16 items-start\">\n          <div className=\"md:col-span-7\">\n            <motion.div\n              initial={{ opacity: 0, x: -20 }}\n              whileInView={{ opacity: 1, x: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5 }}\n            >\n              <h2 className=\"text-[10px] uppercase tracking-[0.4em] mb-8 font-semibold text-[#1A1A1A]/50\">Die Herausforderung</h2>\n              <h3 className=\"text-[40px] md:text-[60px] leading-[0.9] font-black uppercase tracking-tighter mb-8\">\n                Warum bis zu <span className=\"font-serif italic font-normal tracking-normal text-[#1A1A1A]/40\">70% aller Leads</span> nie kontaktiert werden.\n              </h3>\n              <p className=\"text-lg text-[#1A1A1A]/70 mb-12 leading-relaxed max-w-xl\">\n                Ein Interessent f\303\274llt das Kontaktformular aus. Zwei Tage sp\303\244ter hat noch niemand angerufen. Eine Woche sp\303\244ter ist der Kontakt im Postfach untergegangen. Kommt Ihnen das bekannt vor?\n              </p>\n              \n              <div className=\"space-y-12 border-t border-[#1A1A1A]/10 pt-12\">\n                <div className=\"flex gap-8\">\n                  <div className=\"text-[32px] font-serif italic leading-none text-[#1A1A1A]/30\">01.</div>\n                  <div>\n                    <h4 className=\"text-xs uppercase tracking-widest font-bold mb-3\">Zettelwirtschaft & Excel-Chaos</h4>\n                    <p className=\"text-sm leading-relaxed text-[#1A1A1A]/60 max-w-md\">Leads landen in verstreuten Listen, die eigentlich nur eine Person wirklich pflegt. F\303\244llt diese aus, steht der Vertrieb still.</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-8\">\n                  <div className=\"text-[32px] font-serif italic leading-none text-[#1A1A1A]/30\">02.</div>\n                  <div>\n                    <h4 className=\"text-xs uppercase tracking-widest font-bold mb-3\">Unklare Verantwortlichkeiten</h4>\n                    <p className=\"text-sm leading-relaxed text-[#1A1A1A]/60 max-w-md\">Wenn ein Lead theoretisch \"dem ganzen Team\" geh\303\266rt, f\303\274hlt sich in der Praxis niemand wirklich zust\303\244ndig.</p>\n                  </div>\n                </div>\n                <div className=\"flex gap-8\">\n                  <div className=\"text-[32px] font-serif italic leading-none text-[#1A1A1A]/30\">03.</div>\n                  <div>\n                    <h4 className=\"text-xs uppercase tracking-widest font-bold mb-3\">Fehlender Prozess</h4>\n                    <p className=\"text-sm leading-relaxed text-[#1A1A1A]/60 max-w-md\">Nach einem Anruf bleibt es bei einem vagen \"ich melde mich n\303\244chste Woche\". Ohne System geht genau das im Tagesgesch\303\244ft unter.</p>\n                  </div>\n                </div>\n              </div>\n            </motion.div>\n          </div>\n          \n          <div className=\"md:col-span-5 md:pl-10 md:border-l border-[#1A1A1A]/10 h-full\">\n            <motion.div\n              className=\"sticky top-32 flex flex-col justify-between h-[calc(100%-8rem)] min-h-[400px]\"\n              initial={{ opacity: 0, x: 20 }}\n              whileInView={{ opacity: 1, x: 0 }}\n              viewport={{ once: true }}\n              transition={{ duration: 0.5 }}\n            >\n              <div>\n                <div className=\"mb-10\">\n                  <h3 className=\"text-2xl font-serif italic mb-4\">Die L\303\266sung.</h3>\n                  <p className=\"text-sm text-[#1A1A1A]/60 uppercase tracking-widest font-bold\">Ein klares System statt Vorw\303\274rfen an das Team.</p>\n                </div>\n                \n                <ul className=\"space-y-6\">\n                  <li className=\"flex items-start gap-4 border-b border-[#1A1A1A]/10 pb-6\">\n                    <span className=\"w-1.5 h-1.5 bg-[#1A1A1A] rounded-full mt-2 shrink-0\"></span>\n                    <span className=\"text-sm leading-relaxed text-[#1A1A1A]/80\"><strong>Jeder Lead</strong> bekommt einen klaren n\303\244chsten Schritt</span>\n                  </li>\n                  <li className=\"flex items-start gap-4 border-b border-[#1A1A1A]/10 pb-6\">\n                    <span className=\"w-1.5 h-1.5 bg-[#1A1A1A] rounded-full mt-2 shrink-0\"></span>\n                    <span className=\"text-sm leading-relaxed text-[#1A1A1A]/80\"><strong>Klare Zuweisung</strong> an einen spezifischen Mitarbeiter</span>\n                  </li>\n                  <li className=\"flex items-start gap-4 pb-6\">\n                    <span className=\"w-1.5 h-1.5 bg-[#1A1A1A] rounded-full mt-2 shrink-0\"></span>\n                    <span className=\"text-sm leading-relaxed text-[#1A1A1A]/80\"><strong>Automatische Erinnerungen</strong>, bevor ein Lead abk\303\274hlt</span>\n                  </li>\n                </ul>\n              </div>\n              \n              <div className=\"pt-10 border-t border-[#1A1A1A]/10\">\n                <div className=\"text-[64px] font-black tracking-tighter leading-none\">100%</div>\n                <div className=\"text-[10px] uppercase tracking-widest font-bold text-[#1A1A1A]/40 mt-2\">Transparenz im Prozess</div>\n              </div>\n            </motion.div>\n          </div>\n        </div>\n      </div>\n    </section>"
    }
