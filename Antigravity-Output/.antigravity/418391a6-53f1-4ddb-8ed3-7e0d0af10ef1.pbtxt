   </div>\n      </div>\n\n      {/* Mobile menu */}\n      {isOpen && (\n        <div className=\"md:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-4 space-y-4 shadow-lg\">\n          <a href=\"#problem\" className=\"block text-base font-medium text-slate-600\" onClick={() => setIsOpen(false)}>Problem</a>\n          <a href=\"#funktionen\" className=\"block text-base font-medium text-slate-600\" onClick={() => setIsOpen(false)}>Funktionen</a>\n          <a href=\"#preise\" className=\"block text-base font-medium text-slate-600\" onClick={() => setIsOpen(false)}>Preise</a>\n          <div className=\"pt-4 flex flex-col gap-2\">\n            <button className=\"w-full text-center bg-slate-100 text-slate-900 px-4 py-2 rounded-md font-medium\">\n              Login\n            </button>\n            <button className=\"w-full text-center bg-teal-600 text-white px-4 py-2 rounded-md font-medium\">\n              Kostenlos testen\n            </button>\n          </div>\n        </div>\n      )}\n    </nav>\n  );\n}\n"
